      </label>
    `).join('') || '<div class="lcombo-empty">일치하는 대학이 없습니다.</div>';
  }
  function updateUnivFilterToggleLabel(){
    const btn = document.getElementById('lUnivFilterToggle');
    btn.textContent = state.univs.size>0 ? state.univs.size+'개 대학 선택됨' : '대학 입력 · 선택';
