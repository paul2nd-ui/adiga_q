    html += '</tbody></table></div>';
    wrap.innerHTML = html;
  }

  // ---------- 렌더: 정밀 비교(개별 대학·학과 vs 학생 위치를 한 눈금에서 정확히 비교) ----------
  function renderPreciseCompare(t, ref, studentVal){
    const el = document.getElementById('lPreciseCompare');
    const hasQuery = !!state.majorQuery.trim();

    let univPool, subtitle;
    if(ref){
      univPool = t.entries.filter(e=> e.tier>=ref.tier-1 && e.tier<=ref.tier+1);
      subtitle = ref.univ+' 기준 위·아래 1개 군';
    } else if(studentVal!=null){
      univPool = t.entries.slice().sort((a,b)=>Math.abs(a.cut-studentVal)-Math.abs(b.cut-studentVal)).slice(0,12);
      subtitle = '학생 등급('+studentVal.toFixed(2)+')에 가장 가까운 대학들';
    } else {
      el.innerHTML = '';
      return;
    }
    if(!univPool || univPool.length===0){
      el.innerHTML = '<div class="pc-title">정밀 비교</div><div class="pc-empty">비교할 대학 데이터가 없습니다.</div>';
      return;
    }

    let pool;
    if(hasQuery){
      const univSet = new Set(univPool.map(e=>e.u));
      const tierByUniv = new Map(univPool.map(e=>[e.u, e.tier]));
      const grouped = groupRows(filteredRows()).filter(g=> univSet.has(g.univ));
      pool = grouped.map(g=>({
        label: P.univs[g.univ] + ' · ' + P.depts[g.dept],
        cut: g.cut, u: g.univ, region: P.regions[g.region], tier: tierByUniv.get(g.univ),
      }));
    } else {
      pool = univPool.map(e=>({ label: e.univ, cut: e.cut, u: e.u, region: e.region, tier: e.tier }));
    }
    if(pool.length===0){
      el.innerHTML = '<div class="pc-title">정밀 비교</div><div class="pc-empty">현재 조건("'+state.majorQuery.trim()+'" 학과)에 맞는 학과 데이터가 없습니다.</div>';
      return;
    }

    pool.sort((a,b)=>a.cut-b.cut);
    if(pool.length>20){
      const idx = ref ? Math.max(0, pool.findIndex(p=>p.u===ref.u)) : Math.floor(pool.length/2);
      const start = Math.max(0, Math.min(pool.length-20, idx-10));
      pool = pool.slice(start, start+20);
    }

    const vals = pool.map(p=>p.cut);
    let lo = Math.min(...vals), hi = Math.max(...vals);
    if(studentVal!=null){ lo = Math.min(lo, studentVal); hi = Math.max(hi, studentVal); }
    if(hi-lo < 0.6){ const mid=(hi+lo)/2; lo=mid-0.4; hi=mid+0.4; }
    const pad = (hi-lo)*0.10;
    lo -= pad; hi += pad;
    const frac = v => Math.min(100, Math.max(0, (v-lo)/(hi-lo)*100));

    let ticks = '';
    const tickCount = 5;
    for(let i=0;i<=tickCount;i++){
      const v = lo + (hi-lo)*i/tickCount;
      ticks += `<span class="pc-axis-tick" style="left:${(i/tickCount*100).toFixed(2)}%">${v.toFixed(2)}</span>`;
    }

    let rowsHtml = '';
    pool.forEach(p=>{
      const cls = ['pc-dot'];
      if(ref && p.u===ref.u) cls.push('is-ref');
      else if(ref && p.tier===ref.tier+1) cls.push('is-below');
      rowsHtml += `<div class="pc-label" title="${p.label}"><span class="nm">${p.label}</span><span class="vv">${p.cut.toFixed(2)}</span></div>
        <div class="pc-track"><span class="${cls.join(' ')}" style="left:${frac(p.cut).toFixed(2)}%" title="${p.region}"></span></div>`;
    });

    const endLine = (pool.length + 1) + 1;
    let studentHtml = '';
    if(studentVal!=null){
      const sf = frac(studentVal).toFixed(2);
      studentHtml = `<div class="pc-student-line" style="left:${sf}%; grid-row:1 / ${endLine};"></div>
        <div class="pc-student-label" style="left:${sf}%; grid-row:1 / ${endLine};">학생 ${studentVal.toFixed(2)}</div>`;
    }

    el.innerHTML = `
      <div class="pc-title">정밀 비교</div>
      <div class="pc-sub">${subtitle}${hasQuery? ' · "'+state.majorQuery.trim()+'" 학과 단위(대학 · 학과)':' · 대학 단위'} · ${pool.length}개${studentVal==null?' — 학생 등급을 입력하면 위치가 함께 표시됩니다':''}</div>
      <div class="pc-grid${hasQuery?' wide':''}">
        <div></div><div class="pc-axis-row">${ticks}</div>
        ${rowsHtml}
        ${studentHtml}
      </div>`;
  }

  // ---------- 렌더: 사다리 ----------
  function renderLadder(){
    const key = axisKey(state.track, state.admtype);
    const hasQuery = !!state.majorQuery.trim();
    let t, modeLabel;
    if(hasQuery){
      const dyn = buildDynamicTiers();
      if(!dyn){
        document.getElementById('lRefAxisLabel').textContent = '"'+state.majorQuery.trim()+'" 학과 · 조건에 맞는 대학 없음';
        document.getElementById('lRefSummary').innerHTML = '<div class="empty-state" style="flex:1">희망 학과·지역 조건에 맞는 대학이 없습니다. 조건을 넓혀보세요.</div>';
        document.getElementById('lLadderWrap').innerHTML = '';
        return;
      }
      t = dyn; modeLabel = '"'+state.majorQuery.trim()+'" 학과 기준';
    } else {
      t = P.tiers[key]; modeLabel = '전체 학과 평균 기준 (참고용)';
    }
    document.getElementById('lRefAxisLabel').textContent =
      (state.track===0?'인문':state.track===1?'자연':'의치한약수') + ' · ' + (state.admtype===0?'교과전형':'종합전형') + ' · ' + modeLabel + ' (' + t.entries.length + '개교)';

    const byTier = {};
    t.entries.forEach(e=>{ (byTier[e.tier] = byTier[e.tier]||[]).push(e); });
    const maxTier = t.k;
    const studentVal = getStudentVal();

    const refEl = document.getElementById('lRefSummary');
    const ref = state.refUniv!=null ? t.entries.find(e=>e.u===state.refUniv) : null;
    if(ref){
      const below = byTier[ref.tier+1] || [];
      refEl.innerHTML = `
        <div class="ref-card"><div class="label">${ref.univ}</div><div class="value">${ref.tier}군</div><div class="region-tag">전체 ${ref.rank}위 · 대표컷 ${ref.cut.toFixed(2)}등급</div></div>
        <div class="ref-card"><div class="label">같은 군 (${(byTier[ref.tier]||[]).length}개교)</div><div class="items">${(byTier[ref.tier]||[]).map(e=>e.univ).join(', ')}</div></div>
        <div class="ref-card below"><div class="label">한 단계 아래 군 (${below.length}개교)</div><div class="items">${below.map(e=>e.univ).join(', ') || '(최하위군)'}</div></div>
      `;
    } else if(state.refUniv!=null){
      refEl.innerHTML = '<div class="empty-state" style="flex:1">'+P.univs[state.refUniv]+'은(는) 현재 조건('+(hasQuery?'"'+state.majorQuery.trim()+'" 학과':'')+(state.regions.size?' · '+[...state.regions].join(','):'')+')에 해당하는 데이터가 없습니다.</div>';
    } else {
      refEl.innerHTML = '<div class="empty-state" style="flex:1">위 입력창에 대학명을 입력하면(예: 가톨릭대) 이 대학의 군 위치와 한 단계 아래 대학들을 보여드립니다.</div>';
    }

    renderPreciseCompare(t, ref, studentVal);

    const noteEl = document.getElementById('lLadderNote');
    if(noteEl){
      noteEl.textContent = hasQuery
        ? '※ 위 "정밀 비교"의 수치는 대학·학과별 실제 컷이고, 아래 사다리 칩에 마우스를 올리면 나오는 "대표컷"은 그 대학의 매칭 학과들을 합친 중앙값이라 서로 다를 수 있습니다.'
        : '※ 아래 사다리 칩의 "대표컷"은 그 대학 전체 학과를 합친 중앙값입니다. 특정 학과 기준으로 보려면 왼쪽에 희망 학과를 입력하세요.';
    }

    const wrap = document.getElementById('lLadderWrap');
    let html = '';
    for(let i=1;i<=maxTier;i++){
      const list = (byTier[i]||[]).slice().sort((a,b)=>a.rank-b.rank);
      const lo = t.breaks[i-1], hi = t.breaks[i];
      html += `<div class="tier-band"><div class="tier-num">${i}군<small>${lo.toFixed(2)}~${hi.toFixed(2)}</small></div><div class="tier-univs">`;
      list.forEach(e=>{
        const cls = ['u-chip'];
        if(ref && e.univ===ref.univ) cls.push('is-ref');
        else if(ref && e.tier===ref.tier+1) cls.push('is-below');
        const cutLabel = hasQuery ? '매칭학과 중앙값' : '전체학과 중앙값';
        html += `<span class="${cls.join(' ')}" title="${e.region} · ${cutLabel} ${e.cut.toFixed(2)} · ${e.ndept}개 학과">${e.univ}</span>`;
      });
      html += `</div></div>`;
    }
    wrap.innerHTML = html;

    const bands = wrap.querySelectorAll('.tier-band');
    let marker = wrap.querySelector('.marker-line');
    if(marker) marker.remove();
    let mlabel = wrap.querySelector('.marker-label');
    if(mlabel) mlabel.remove();
    if(studentVal!=null && bands.length){
      const breaks = t.breaks;
      // 학생 등급이 표시된 사다리 구간(breaks[0]~breaks[마지막]) 밖에 있을 때의 기본값을 방향에 맞게 정한다.
      // (예: 1군 하한보다 더 낮은=더 좋은 등급이면 맨 위 1군 쪽에, 마지막 군 상한보다 높은=더 나쁜 등급이면 맨 아래 마지막 군 쪽에
      //  둬야 하는데, 예전 코드는 무조건 마지막 군(breaks.length-2)을 기본값으로 써서 더 좋은 등급도 항상 맨 아래로 잘못 표시됐다.)
      let tierIdx;
      if(studentVal <= breaks[0]){
        tierIdx = 0;
      } else if(studentVal >= breaks[breaks.length-1]){
        tierIdx = breaks.length-2;
      } else {
        tierIdx = breaks.length-2;
        for(let i=0;i<breaks.length-1;i++){
          if(studentVal>=breaks[i] && studentVal<=breaks[i+1]){ tierIdx=i; break; }
        }
      }
      const lo = breaks[tierIdx], hi = breaks[tierIdx+1];
      const frac = hi>lo ? Math.min(1,Math.max(0,(studentVal-lo)/(hi-lo))) : 0.5;
      const band = bands[Math.min(tierIdx, bands.length-1)];
      const top = band.offsetTop + band.offsetHeight*frac;
      const m = document.createElement('div');
      m.className='marker-line';
      m.style.top = top+'px';
      const lbl = document.createElement('div');
      lbl.className='marker-label';
      lbl.style.top = top+'px';
      lbl.textContent = '학생 위치 '+studentVal.toFixed(2);
      wrap.style.position='relative';
      wrap.appendChild(m);
      wrap.appendChild(lbl);
    }
  }

  function renderAll(){
    document.getElementById('lCoreLabel').textContent = coreLabelText();
    if(state.mainTab==='match') renderMatch();
    else if(state.mainTab==='ladder') renderLadder();
    else if(state.mainTab==='favorites') renderFavorites();
  }

  // ---------- 이벤트 바인딩 ----------
  document.getElementById('lTrackSeg').addEventListener('click', e=>{
    const b = e.target.closest('button'); if(!b) return;
    state.track = +b.dataset.v;
    [...b.parentElement.children].forEach(c=>c.classList.toggle('on', c===b));
    renderDeptChecklist();
    renderAll();
  });
  document.getElementById('lAdmSeg').addEventListener('click', e=>{
    const b = e.target.closest('button'); if(!b) return;
    state.admtype = +b.dataset.v;
    [...b.parentElement.children].forEach(c=>c.classList.toggle('on', c===b));
    renderDeptChecklist();
    renderAll();
  });
  document.querySelector('#ladder-view .tabs').addEventListener('click', e=>{
    const b = e.target.closest('button'); if(!b) return;
    state.mainTab = b.dataset.v;
    [...b.parentElement.children].forEach(c=>c.classList.toggle('on', c===b));
    document.getElementById('lView-match').classList.toggle('on', state.mainTab==='match');
    document.getElementById('lView-ladder').classList.toggle('on', state.mainTab==='ladder');
    document.getElementById('lView-favorites').classList.toggle('on', state.mainTab==='favorites');
    renderAll();
  });

  // 학과 매칭 표: 헤더 클릭 = 정렬, 행 클릭 = 미니 상세 팝업(3개년 추이 + 관심대학 저장)
  document.getElementById('lMatchGroups').addEventListener('click', e=>{
    const th = e.target.closest('th[data-sort-key]');
    if(th){
      const key = th.dataset.sortKey;
      if(state.sortKey===key) state.sortDir = -state.sortDir;
      else { state.sortKey = key; state.sortDir = 1; }
      renderMatch();
      return;
    }
    const tr = e.target.closest('tr[data-idx]');
    if(tr){
      const g = renderedEntries[+tr.dataset.idx];
      if(g) openDetailModal(g);
    }
  });
  document.getElementById('lDetailClose').addEventListener('click', closeDetailModal);
  document.getElementById('lDetailBackdrop').addEventListener('click', e=>{
    if(e.target.id==='lDetailBackdrop') closeDetailModal();
  });

  // 관심 대학 목록: 내보내기/불러오기/전체 비우기/개별 삭제
  document.getElementById('lFavExportBtn').addEventListener('click', ()=>{
    const list = loadFavorites();
    const blob = new Blob([JSON.stringify(list, null, 2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = '관심대학목록.json';
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
  });
  document.getElementById('lFavImportBtn').addEventListener('click', ()=>{
    document.getElementById('lFavImportFile').click();
  });
  document.getElementById('lFavImportFile').addEventListener('change', e=>{
    const file = e.target.files[0];
    e.target.value = '';
    if(!file) return;
    const reader = new FileReader();
    reader.onload = ()=>{
      try{
        const imported = JSON.parse(reader.result);
        if(!Array.isArray(imported)) return;
        const cur = loadFavorites();
        const seen = new Set(cur.map(f=>favKey(f)));
        imported.forEach(f=>{
          if(f && f.univ && f.dept && !seen.has(favKey(f))){ cur.push(f); seen.add(favKey(f)); }
        });
        saveFavoritesList(cur);
        renderFavorites();
      }catch(err){ /* 형식이 안 맞는 파일은 조용히 무시 */ }
    };
    reader.readAsText(file);
  });
  document.getElementById('lFavClearBtn').addEventListener('click', ()=>{
    saveFavoritesList([]);
    renderFavorites();
  });
  document.getElementById('lFavList').addEventListener('click', e=>{
    const btn = e.target.closest('.fav-remove-btn'); if(!btn) return;
    const list = loadFavorites().filter(f=>favKey(f)!==btn.dataset.favkey);
    saveFavoritesList(list);
    renderFavorites();
  });
  document.getElementById('lAllAvg').addEventListener('input', e=>{ state.allAvg = e.target.value? parseFloat(e.target.value):null; renderAll(); });
  document.getElementById('lCoreAvg').addEventListener('input', e=>{ state.coreAvg = e.target.value? parseFloat(e.target.value):null; renderAll(); });
  document.getElementById('lMajorQuery').addEventListener('input', e=>{
    state.majorQuery = e.target.value;
    state.selectedDepts = new Set(); // 검색어가 바뀌면 세부 선택 초기화
    const hitEl = document.getElementById('lMajorHits');
    const sm = matchedSubdeptIdx(state.majorQuery);
    if(sm && sm.size>0){
      hitEl.textContent = '매칭된 계열: ' + [...sm].slice(0,8).map(i=>P.subdepts[i]).join(', ') + (sm.size>8?' 외 '+(sm.size-8)+'개':'');
    } else if(state.majorQuery.trim()) {
      hitEl.textContent = '유사 계열 매칭 없음 — 학과명 직접 검색으로 대체합니다.';
    } else {
      hitEl.textContent = '';
    }
    renderDeptChecklist();
    renderAll();
  });

  // 대학 필터 콤보박스: 토글 열기/닫기, 검색, 개별/전체 선택, 바깥 클릭 시 닫기
  document.getElementById('lUnivFilterToggle').addEventListener('click', ()=>{
    const panel = document.getElementById('lUnivFilterPanel');
    const willOpen = !panel.classList.contains('open');
    panel.classList.toggle('open', willOpen);
    if(willOpen) renderUnivFilterList(document.getElementById('lUnivFilterSearch').value);
  });
  document.getElementById('lUnivFilterSearch').addEventListener('input', e=> renderUnivFilterList(e.target.value));
  document.getElementById('lUnivFilterList').addEventListener('change', e=>{
    const cb = e.target.closest('input[type=checkbox]'); if(!cb) return;
    const idx = +cb.value;
    const name = P.univs[idx];
    if(cb.checked) state.univs.add(name); else state.univs.delete(name);
    updateUnivFilterToggleLabel();
    renderAll();
  });
  document.getElementById('lUnivFilterAll').addEventListener('click', ()=>{
    const q = document.getElementById('lUnivFilterSearch').value.trim();
    const items = q ? univFilterList.filter(o=>o.name.includes(q)) : univFilterList;
    items.forEach(o=> state.univs.add(o.name));
    updateUnivFilterToggleLabel();
    renderUnivFilterList(q);
    renderAll();
  });
  document.getElementById('lUnivFilterNone').addEventListener('click', ()=>{
    const q = document.getElementById('lUnivFilterSearch').value.trim();
    const items = q ? univFilterList.filter(o=>o.name.includes(q)) : univFilterList;
    items.forEach(o=> state.univs.delete(o.name));
    updateUnivFilterToggleLabel();
    renderUnivFilterList(q);
    renderAll();
  });
  document.addEventListener('click', e=>{
    const combo = document.getElementById('lUnivFilterCombo');
    if(combo && !combo.contains(e.target)){
      document.getElementById('lUnivFilterPanel').classList.remove('open');
    }
  });

  // 모집단위(학과) 보조 체크리스트: 체크 시 그 학과만으로 결과를 좁힘
  document.getElementById('lDeptChecklist').addEventListener('change', e=>{
    const cb = e.target.closest('input[type=checkbox]'); if(!cb) return;
    const idx = +cb.value;
    if(cb.checked) state.selectedDepts.add(idx); else state.selectedDepts.delete(idx);
    renderAll();
  });
  document.getElementById('lMarginSafe').addEventListener('input', e=>{
    state.marginSafe = parseFloat(e.target.value);
    document.getElementById('lMarginSafeVal').textContent = state.marginSafe.toFixed(2);
    renderAll();
  });
  document.getElementById('lMarginReach').addEventListener('input', e=>{
    state.marginReach = parseFloat(e.target.value);
    document.getElementById('lMarginReachVal').textContent = state.marginReach.toFixed(2);
    renderAll();
  });
  document.getElementById('lMethBtn').addEventListener('click', ()=>{
    document.getElementById('lMethBox').classList.toggle('open');
  });

  function resetAll(){
    state.track = 0; state.admtype = 0; state.mainTab = 'match';
    state.allAvg = null; state.coreAvg = null; state.majorQuery = '';
    state.regions = new Set(); state.marginSafe = 0.3; state.marginReach = 0.7;
    state.refUniv = null; state.sortKey = 'cut'; state.sortDir = 1;
    state.univs = new Set(); state.selectedDepts = new Set();

    const trackSeg = document.getElementById('lTrackSeg');
    [...trackSeg.children].forEach(c=> c.classList.toggle('on', c.dataset.v==='0'));
    const admSeg = document.getElementById('lAdmSeg');
    [...admSeg.children].forEach(c=> c.classList.toggle('on', c.dataset.v==='0'));
    const mainTabs = document.querySelector('#ladder-view .tabs');
    [...mainTabs.children].forEach(c=> c.classList.toggle('on', c.dataset.v==='match'));
    document.getElementById('lView-match').classList.add('on');
    document.getElementById('lView-ladder').classList.remove('on');
    document.getElementById('lView-favorites').classList.remove('on');

    document.getElementById('lAllAvg').value = '';
    document.getElementById('lCoreAvg').value = '';
    document.getElementById('lMajorQuery').value = '';
    document.getElementById('lMajorHits').textContent = '';
    document.getElementById('lRefUnivInput').value = '';

    document.querySelectorAll('#lRegionGrid .region-chip').forEach(el=> el.classList.remove('on'));

    document.getElementById('lUnivFilterSearch').value = '';
    document.getElementById('lUnivFilterPanel').classList.remove('open');
    updateUnivFilterToggleLabel();
    document.getElementById('lDeptChecklist').innerHTML = '';
    document.getElementById('lDeptChecklist').classList.remove('open');

    document.getElementById('lMarginSafe').value = '0.3';
    document.getElementById('lMarginSafeVal').textContent = '0.30';
    document.getElementById('lMarginReach').value = '0.7';
    document.getElementById('lMarginReachVal').textContent = '0.70';

    renderAll();
  }
  document.getElementById('lResetBtn').addEventListener('click', resetAll);
  document.getElementById('lRefUnivInput').addEventListener('input', e=>{
    const v = e.target.value.trim();
    const idx = P.univs.indexOf(v);
    state.refUniv = idx>=0 ? idx : null;
    renderLadder();
  });

  const regionGrid = document.getElementById('lRegionGrid');
  P.regions.forEach(r=>{
    const el = document.createElement('div');
    el.className = 'region-chip'; el.textContent = r; el.dataset.r = r;
    el.addEventListener('click', ()=>{
      if(state.regions.has(r)) state.regions.delete(r); else state.regions.add(r);
      el.classList.toggle('on', state.regions.has(r));
      renderAll();
    });
    regionGrid.appendChild(el);
  });

  const dl = document.getElementById('lUnivList');
  P.univs.forEach(u=>{ const o=document.createElement('option'); o.value=u; dl.appendChild(o); });

  window.LadderApp = { renderAll: renderAll };
})();
