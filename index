function fmt(v, digits){
  if(v===null || v===undefined) return '-';
  if(digits!==undefined) return (+v).toFixed(digits);
  return v;
}

function escapeHtml(s){
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

