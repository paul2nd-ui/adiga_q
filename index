    // 정시는 대학당 군·학과 조합 수가 수시보다 훨씬 적어서, 수시 탭과 달리 처음부터 전부 선택된 상태로 보여준다
    // (수시처럼 매번 직접 체크하게 하지 않고, 대학을 고르면 바로 전체 결과가 보이게).
    jrState.guns = new Set(jrGetAvailGuns());
    jrState.tracks = new Set(jrGetAvailTracks());
    document.getElementById('jrChTitle').textContent = JR_UNIVS[i];
    document.getElementById('jrEmptyCard').style.display = 'none';
    document.getElementById('jrDataCard').style.display = 'block';
    jrRenderUnivList();
    jrRenderCombo('gun');
    jrRenderCombo('track');
    jrRenderPivot();
  }

  // ---------- 모집군 / 계열 콤보 필터 (기존 대시보드의 .combo/.combo-btn/.combo-panel 클래스를 그대로 재사용) ----------
  function jrGetAvailGuns(){
    if(jrState.univIdx===null) return [];
    const found = new Set(JR_ROWS.filter(r=>r[JRC.UNIV]===jrState.univIdx).map(r=>JR_GUNS[r[JRC.GUN]]));
    return JR_GUNS.filter(g=>found.has(g));
  }
  function jrGetAvailTracks(){
    if(jrState.univIdx===null) return [];
    const found = new Set(JR_ROWS.filter(r=>r[JRC.UNIV]===jrState.univIdx).map(r=>JR_TRACKS[r[JRC.TRACK]]));
    return JR_TRACKS.filter(t=>found.has(t));
  }
  const JR_COMBO_DEFS = {
    gun:   { label:'모집군',    getAvail: jrGetAvailGuns,   onChange: ()=>{ jrRenderPivot(); } },
    track: { label:'인문/자연', getAvail: jrGetAvailTracks, onChange: ()=>{ jrRenderPivot(); } },
  };
  function jrGetStateSet(kind){ return kind==='gun' ? jrState.guns : jrState.tracks; }
  function jrSetStateSet(kind, s){ if(kind==='gun') jrState.guns = s; else jrState.tracks = s; }

  function jrRenderCombo(kind){
    const def = JR_COMBO_DEFS[kind];
    const btn = document.getElementById('jrCombo' + (kind==='gun'?'Gun':'Track') + 'Btn');
    const panel = document.getElementById('jrCombo' + (kind==='gun'?'Gun':'Track') + 'Panel');

    if(jrState.univIdx===null){
      btn.textContent = def.label;
      btn.classList.remove('has-selection');
      panel.innerHTML = '';
      panel.classList.remove('open');
      return;
    }

    const avail = def.getAvail();
    let cur = jrGetStateSet(kind);
    cur = new Set([...cur].filter(a => avail.includes(a)));
    jrSetStateSet(kind, cur);

    btn.innerHTML = def.label + ' <span class="combo-count">' + cur.size + '/' + avail.length + '</span> <span class="combo-arrow">▾</span>';
    btn.classList.toggle('has-selection', cur.size > 0 && cur.size < avail.length);

    if(avail.length===0){
      panel.innerHTML = '<div class="combo-empty">선택 가능한 항목이 없어요</div>';
      return;
    }

    let html = '<div class="combo-panel-head"><a data-op="all">전체선택</a><span>·</span><a data-op="none">전체해제</a></div>';
    avail.forEach(v=>{
      const checked = cur.has(v) ? 'checked' : '';
      html += '<label class="combo-item"><input type="checkbox" value="' + jrEscapeHtml(v) + '" ' + checked + '> ' + jrEscapeHtml(v) + '</label>';
    });
    panel.innerHTML = html;

    panel.querySelectorAll('a[data-op]').forEach(a=>{
      a.addEventListener('click', ()=>{
        const op = a.dataset.op;
        jrSetStateSet(kind, op==='all' ? new Set(avail) : new Set());
        jrRenderCombo(kind);
        panel.classList.add('open');
        def.onChange();
      });
    });
    panel.querySelectorAll('input[type=checkbox]').forEach(cb=>{
      cb.addEventListener('change', ()=>{
        const s = jrGetStateSet(kind);
        if(cb.checked) s.add(cb.value); else s.delete(cb.value);
        btn.querySelector('.combo-count').textContent = s.size + '/' + avail.length;
        btn.classList.toggle('has-selection', s.size > 0 && s.size < avail.length);
        def.onChange();
      });
    });
  }

  function jrBindComboToggles(){
    ['gun','track'].forEach(kind=>{
      const btn = document.getElementById('jrCombo' + (kind==='gun'?'Gun':'Track') + 'Btn');
      const panel = document.getElementById('jrCombo' + (kind==='gun'?'Gun':'Track') + 'Panel');
      btn.addEventListener('click', (e)=>{
        e.stopPropagation();
        const isOpen = panel.classList.contains('open');
        // 열려있는 다른 콤보(수시 탭의 것 포함)는 이 대시보드 공통 규칙대로 전부 닫는다.
        document.querySelectorAll('.combo-panel.open').forEach(p=>p.classList.remove('open'));
        if(!isOpen) panel.classList.add('open');
      });
      panel.addEventListener('click', e=> e.stopPropagation());
    });
    // 바깥 클릭 시 콤보를 닫는 동작은 기존 대시보드 스크립트의 bindComboToggles()가
    // document 전역에 이미 등록해 둔 '.combo-panel.open 전부 닫기' 리스너가 처리하므로 여기서 따로 추가하지 않는다.
  }

  // ---------- 대학별 탐색: 연도별 피벗 테이블 ----------
  function jrBuildYearSubheader(elId){
    const tr = document.getElementById(elId);
    tr.innerHTML = '';
    ['g70','g50','cap','cr','rc'].forEach(g=>{
      JR_YEARS.forEach(y=>{
        const th = document.createElement('th');
        th.className = g;
        th.textContent = y;
        tr.appendChild(th);
      });
    });
  }

  function jrCellVal(row, field){
    if(!row) return '-';
    const raw = row[JRC[field]];
    if(raw===null || raw===undefined) return '-';
    return (field==='CAP') ? raw : (+raw).toFixed(1);
  }

  function jrRenderPivot(){
    if(jrState.univIdx===null) return;
    const deptQ = jrState.deptSearch.trim().toLowerCase();
    const rows = JR_ROWS.filter(r=>
      r[JRC.UNIV]===jrState.univIdx &&
      JR_YEARS.includes(r[JRC.YEAR]) &&
      jrState.guns.has(JR_GUNS[r[JRC.GUN]]) &&
      jrState.tracks.has(JR_TRACKS[r[JRC.TRACK]])
    );

    const combos = new Map(); // key: gun|adm|dept
    rows.forEach(r=>{
      const key = r[JRC.GUN] + '|' + r[JRC.ADM] + '|' + r[JRC.DEPT];
      if(!combos.has(key)) combos.set(key, { univIdx:jrState.univIdx, gunIdx:r[JRC.GUN], admIdx:r[JRC.ADM], deptIdx:r[JRC.DEPT], track:r[JRC.TRACK], years:{} });
      combos.get(key).years[r[JRC.YEAR]] = r;
    });

    let list = [...combos.values()];
    if(deptQ){
      list = list.filter(c => JR_DEPTS[c.deptIdx].toLowerCase().includes(deptQ) || JR_ADMS[c.admIdx].toLowerCase().includes(deptQ));
    }
    list.sort((a,b)=> (JR_GUNS[a.gunIdx]+JR_ADMS[a.admIdx]+JR_DEPTS[a.deptIdx]).localeCompare(JR_GUNS[b.gunIdx]+JR_ADMS[b.admIdx]+JR_DEPTS[b.deptIdx], 'ko'));

    document.getElementById('jrChMeta').textContent = list.length.toLocaleString() + '개 모집군·전형·학과 조합 · ' + (jrUnivRegion[jrState.univIdx]||'');

    jrBuildYearSubheader('jrYearSubheader');

    const tbody = document.getElementById('jrPivotBody');
    if(list.length===0){
      const nothingChosen = jrState.guns.size===0 || jrState.tracks.size===0;
      const msg = nothingChosen
        ? '👆 대학 이름 옆의 [모집군] [인문/자연] 버튼을 눌러 보고 싶은 항목을 체크하세요.'
        : '조건에 맞는 데이터가 없습니다. 위 필터나 학과 검색어를 확인해보세요.';
      tbody.innerHTML = '<tr><td colspan="16" style="text-align:center;padding:30px;color:#9aa0a8;">' + msg + '</td></tr>';
      return;
    }

    const html = list.map((c,i)=>{
      const label = jrEscapeHtml('[' + JR_GUNS[c.gunIdx] + '군] ' + JR_ADMS[c.admIdx] + ' ' + JR_DEPTS[c.deptIdx]);
      let cells = '';
      ['AVG70','AVG50','CAP','CR','RC'].forEach(field=>{
        const cls = {AVG70:'g70',AVG50:'g50',CAP:'cap',CR:'cr',RC:'rc'}[field];
        JR_YEARS.forEach(y=>{
          cells += '<td class="' + cls + '">' + jrCellVal(c.years[y], field) + '</td>';
        });
      });
      return '<tr data-idx="' + i + '"><td class="rowlabel" title="' + label + '">' + label + '</td>' + cells + '</tr>';
    }).join('');
    tbody.innerHTML = html;

    tbody.querySelectorAll('tr[data-idx]').forEach(tr=>{
      tr.addEventListener('click', ()=>{
        const c = list[+tr.dataset.idx];
        if(c) jrShowDetail(c);
      });
    });
  }

  // ---------- 학과 전체검색 ----------
  function jrRenderSearchRegionFilter(){
    const el = document.getElementById('jrSearchRegionFilter');
    if(!el) return;
    el.innerHTML = '';
    JR_REGIONS.forEach(r=>{
      const cls = JR_REGION_GROUP[r] || '';
      const item = document.createElement('div');
      item.className = 'region-item ' + cls + (jrState.searchRegions.has(r) ? ' active' : '');
      item.textContent = r;
      item.addEventListener('click', ()=>{
        if(jrState.searchRegions.has(r)) jrState.searchRegions.delete(r); else jrState.searchRegions.add(r);
        jrRenderSearchPivot();
      });
      el.appendChild(item);
    });
  }

  function jrSetSearchSort(mode){
    jrState.searchSortBy = mode;
    document.getElementById('jrSortUnivBtn').classList.toggle('active', mode==='univ');
    document.getElementById('jrSortRegionBtn').classList.toggle('active', mode==='region');
    document.getElementById('jrSortCutBtn').classList.toggle('active', mode==='cut');
    jrRenderSearchPivot();
  }

  function jrRepCut(c){
    // 정렬용 대표컷: 70%/50% 백분위 평균 중 있는 값의 평균 (수시의 cut = avg(g50,g70) 과 동일한 개념,
    // 다만 백분위는 높을수록 상위권이라 방향이 반대).
    const latestYear = [2026,2025,2024].find(y=>c.years[y]);
    if(!latestYear) return -1;
    const row = c.years[latestYear];
    const vals = [row[JRC.AVG50], row[JRC.AVG70]].filter(v=>v!=null);
    return vals.length ? vals.reduce((a,b)=>a+b,0)/vals.length : -1;
  }

  function jrRenderSearchPivot(){
    const q = jrState.globalDeptQuery.trim().toLowerCase();
    const metaEl = document.getElementById('jrSearchMeta');
    const tbody = document.getElementById('jrSearchPivotBody');

    jrBuildYearSubheader('jrSearchYearSubheader');
    jrRenderSearchRegionFilter();

    if(!q){
      metaEl.textContent = '학과명을 입력하면 전체 대학의 정시 결과를 보여드려요. (예: 간호학과, 컴퓨터공학, 경영학)';
      tbody.innerHTML = '<tr><td colspan="16" style="text-align:center;padding:30px;color:#9aa0a8;">🔍 위 검색창에 학과명을 입력해보세요</td></tr>';
      return;
    }

    const rows = JR_ROWS.filter(r => JR_YEARS.includes(r[JRC.YEAR]) && JR_DEPTS[r[JRC.DEPT]].toLowerCase().includes(q) &&
      (jrState.searchRegions.size===0 || jrState.searchRegions.has(JR_REGIONS[r[JRC.REG]])));

    const combos = new Map(); // key: univ|gun|adm|dept
    rows.forEach(r=>{
      const key = r[JRC.UNIV] + '|' + r[JRC.GUN] + '|' + r[JRC.ADM] + '|' + r[JRC.DEPT];
      if(!combos.has(key)) combos.set(key, { univIdx:r[JRC.UNIV], gunIdx:r[JRC.GUN], admIdx:r[JRC.ADM], deptIdx:r[JRC.DEPT], track:r[JRC.TRACK], years:{} });
      combos.get(key).years[r[JRC.YEAR]] = r;
    });

    let list = [...combos.values()];
    if(jrState.searchSortBy === 'region'){
      list.sort((a,b)=>{
        const ra = JR_REGIONS.indexOf(jrUnivRegion[a.univIdx]), rb = JR_REGIONS.indexOf(jrUnivRegion[b.univIdx]);
        if(ra !== rb) return ra - rb;
        return (JR_UNIVS[a.univIdx]+JR_ADMS[a.admIdx]+JR_DEPTS[a.deptIdx]).localeCompare(JR_UNIVS[b.univIdx]+JR_ADMS[b.admIdx]+JR_DEPTS[b.deptIdx], 'ko');
      });
    } else if(jrState.searchSortBy === 'cut'){
      list.sort((a,b)=> jrRepCut(b) - jrRepCut(a)); // 백분위는 높을수록 상위권이라 내림차순
    } else {
      list.sort((a,b)=> (JR_UNIVS[a.univIdx]+JR_ADMS[a.admIdx]+JR_DEPTS[a.deptIdx]).localeCompare(JR_UNIVS[b.univIdx]+JR_ADMS[b.admIdx]+JR_DEPTS[b.deptIdx], 'ko'));
    }

    if(list.length===0){
      metaEl.textContent = '"' + q + '"에 해당하는 학과를 찾을 수 없습니다.';
      tbody.innerHTML = '<tr><td colspan="16" style="text-align:center;padding:30px;color:#9aa0a8;">조건에 맞는 학과가 없습니다. 다른 검색어를 입력해보세요.</td></tr>';
      return;
    }

    const univCount = new Set(list.map(c=>c.univIdx)).size;
    const filterNote = jrState.searchRegions.size > 0 ? ' (지역 필터 적용중: ' + [...jrState.searchRegions].join(', ') + ')' : '';
    metaEl.textContent = univCount.toLocaleString() + '개 대학 · ' + list.length.toLocaleString() + '개 모집군·전형·학과 조합' + filterNote;

    const html = list.map((c,i)=>{
      const label = jrEscapeHtml(JR_UNIVS[c.univIdx] + ' (' + (jrUnivRegion[c.univIdx]||'') + ') · [' + JR_GUNS[c.gunIdx] + '군] ' + JR_ADMS[c.admIdx] + ' ' + JR_DEPTS[c.deptIdx]);
      let cells = '';
      ['AVG70','AVG50','CAP','CR','RC'].forEach(field=>{
        const cls = {AVG70:'g70',AVG50:'g50',CAP:'cap',CR:'cr',RC:'rc'}[field];
        JR_YEARS.forEach(y=>{
          cells += '<td class="' + cls + '">' + jrCellVal(c.years[y], field) + '</td>';
        });
      });
      return '<tr data-idx="' + i + '"><td class="rowlabel" title="' + label + '">' + label + '</td>' + cells + '</tr>';
    }).join('');
    tbody.innerHTML = html;

    tbody.querySelectorAll('tr[data-idx]').forEach(tr=>{
      tr.addEventListener('click', ()=>{
        const c = list[+tr.dataset.idx];
        if(c) jrShowDetail(c);
      });
    });
  }

  // ---------- 행 클릭 상세보기 (연도별 백분위50/70·경쟁률 추이 차트 + 표) ----------
  function jrShowDetail(combo){
    const panel = document.getElementById('jrDetailPanel');
    panel.classList.add('show');
    document.getElementById('jrDetailTitle').textContent =
      JR_UNIVS[combo.univIdx] + ' · [' + JR_GUNS[combo.gunIdx] + '군] ' + JR_ADMS[combo.admIdx] + ' ' + JR_DEPTS[combo.deptIdx];
    document.getElementById('jrDetailMeta').textContent = JR_TRACKS[combo.track] + ' · ' + (jrUnivRegion[combo.univIdx]||'');

    const avg50 = JR_YEARS.map(y=> combo.years[y] && combo.years[y][JRC.AVG50]!=null ? combo.years[y][JRC.AVG50] : null);
    const avg70 = JR_YEARS.map(y=> combo.years[y] && combo.years[y][JRC.AVG70]!=null ? combo.years[y][JRC.AVG70] : null);
    const cr = JR_YEARS.map(y=> combo.years[y] && combo.years[y][JRC.CR]!=null ? combo.years[y][JRC.CR] : null);

    const ctx = document.getElementById('jrChartDetail').getContext('2d');
    try{
      if(jrDetailChart) jrDetailChart.destroy();
      jrDetailChart = new Chart(ctx, {
        type: 'line',
        data: { labels: JR_YEARS, datasets: [
          { label:'50%컷(백분위)', data:avg50, borderColor:'#3b5bdb', backgroundColor:'#3b5bdb20', borderWidth:2, spanGaps:true, tension:.25, pointRadius:4, yAxisID:'y' },
          { label:'70%컷(백분위)', data:avg70, borderColor:'#e8590c', backgroundColor:'#e8590c20', borderWidth:2, spanGaps:true, tension:.25, pointRadius:4, yAxisID:'y' },
          { label:'경쟁률', data:cr, borderColor:'#2f9e63', backgroundColor:'#2f9e6320', borderWidth:2, borderDash:[6,3], spanGaps:true, tension:.25, pointRadius:4, yAxisID:'y1' },
        ]},
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: 'top' } },
          scales: {
            y: { position:'left', title:{display:true, text:'백분위 (높을수록 상위권)'} },
            y1: { position:'right', beginAtZero:true, title:{display:true, text:'경쟁률'}, grid:{drawOnChartArea:false} },
          },
        },
      });
    }catch(e){ console.warn('jr detail chart failed', e); }

    const tbody = document.querySelector('#jrDetailTable tbody');
    tbody.innerHTML = JR_YEARS.map(y=>{
      const row = combo.years[y];
      const cap = row && row[JRC.CAP]!=null ? row[JRC.CAP] : '-';
      const crv = row && row[JRC.CR]!=null ? (+row[JRC.CR]).toFixed(2) : '-';
      const chv = row && row[JRC.CH]!=null ? row[JRC.CH] : '-';
      const a50 = row && row[JRC.AVG50]!=null ? (+row[JRC.AVG50]).toFixed(1) : '-';
      const a70 = row && row[JRC.AVG70]!=null ? (+row[JRC.AVG70]).toFixed(1) : '-';
      return '<tr><td class="dyear">' + y + '</td><td>' + cap + '</td><td>' + crv + '</td><td>' + chv + '</td><td>' + a50 + '</td><td>' + a70 + '</td></tr>';
    }).join('');

    if(typeof panel.scrollIntoView === 'function'){ try{ panel.scrollIntoView({behavior:'smooth', block:'nearest'}); }catch(e){} }
  }
  function jrCloseDetail(){
    document.getElementById('jrDetailPanel').classList.remove('show');
  }

  // ---------- 서브탭/상단탭 전환 ----------
  function jrSwitchSubTab(v){
    document.getElementById('jrView-univ').classList.toggle('on', v==='univ');
    document.getElementById('jrView-dept').classList.toggle('on', v==='dept');
    document.querySelectorAll('.jr-subtab-btn').forEach(b=> b.classList.toggle('on', b.dataset.v===v));
    jrCloseDetail();
    if(v==='dept') jrRenderSearchPivot();
  }
  function jrSwitchTopView(v){
    document.getElementById('jsView-search').classList.toggle('on', v==='search');
    document.getElementById('jsView-static').classList.toggle('on', v==='static');
    document.querySelectorAll('.js-toptab-btn').forEach(b=> b.classList.toggle('on', b.dataset.v===v));
    jrCloseDetail();
  }

  // 모의고사 배치표 내부 서브탭 ("대학 배치표" / "백분위-등급 환산표") — jr-subtab-btn과는
  // 별개의 클래스(.jss-subtab-btn)를 써서 jrSwitchSubTab(대학별탐색/학과전체검색용)과 절대 섞이지 않게 함
  function jssSwitchSubTab(v){
    document.getElementById('jsStaticView-univ').classList.toggle('on', v==='univ');
    document.getElementById('jsStaticView-grade').classList.toggle('on', v==='grade');
    document.querySelectorAll('.jss-subtab-btn').forEach(b=> b.classList.toggle('on', b.dataset.v===v));
  }

  // ---------- 초기 바인딩 ----------
  document.querySelectorAll('.js-toptab-btn').forEach(b=> b.addEventListener('click', ()=> jrSwitchTopView(b.dataset.v)));
  document.querySelectorAll('.jr-subtab-btn').forEach(b=> b.addEventListener('click', ()=> jrSwitchSubTab(b.dataset.v)));
  document.querySelectorAll('.jss-subtab-btn').forEach(b=> b.addEventListener('click', ()=> jssSwitchSubTab(b.dataset.v)));

  document.getElementById('jrUnivSearch').addEventListener('input', e=>{ jrState.univSearch = e.target.value; jrRenderUnivList(); });
  document.getElementById('jrDeptSearch').addEventListener('input', e=>{ jrState.deptSearch = e.target.value; jrRenderPivot(); });
  document.getElementById('jrGlobalDeptSearch').addEventListener('input', e=>{ jrState.globalDeptQuery = e.target.value; jrRenderSearchPivot(); });
  document.getElementById('jrSortUnivBtn').addEventListener('click', ()=> jrSetSearchSort('univ'));
  document.getElementById('jrSortRegionBtn').addEventListener('click', ()=> jrSetSearchSort('region'));
  document.getElementById('jrSortCutBtn').addEventListener('click', ()=> jrSetSearchSort('cut'));
  document.getElementById('jrDetailClose').addEventListener('click', jrCloseDetail);

  jrBindComboToggles();
  jrRenderRegionList();
  jrRenderUnivList();

  window.JeongsiSearchApp = { renderAll: ()=>{ jrRenderUnivList(); if(jrState.univIdx!==null) jrRenderPivot(); jrRenderSearchPivot(); } };
})();
</script><script>
(function(){
  function normalize(s){ return (s||'').toLowerCase(); }

  function filterRows(query){
    var q = normalize(query).trim();
    var rows = document.querySelectorAll('#dmTableBody tr');
    var visibleCount = 0;
    rows.forEach(function(tr){
      var hay = normalize(tr.textContent);
      var match = !q || hay.indexOf(q) !== -1;
      tr.classList.toggle('dm-hide', !match);
      if(match) visibleCount++;
    });
    var emptyRow = document.getElementById('dmEmptyRow');
    if(emptyRow) emptyRow.style.display = visibleCount === 0 ? '' : 'none';
  }

  function bindDualMajor(){
    var search = document.getElementById('dmSearch');
    if(!search) return;
    search.addEventListener('input', function(){ filterRows(search.value); });
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', bindDualMajor);
  } else {
