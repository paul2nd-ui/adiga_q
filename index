function getAvailTracks(){
  if(state.univIdx===null) return [];
  const found = new Set(ALL.filter(r=>r[C.UNIV]===state.univIdx).map(r=>TRACKS[r[C.TRACK]]));
  return TRACKS.filter(t=>found.has(t));
}
function getAvailAdms(){
  if(state.univIdx===null) return [];
  return [...new Set(ALL.filter(r=> r[C.UNIV]===state.univIdx && state.types.has(TYPES[r[C.TYPE]])).map(r=>ADMS[r[C.ADM]]))].sort((a,b)=>a.localeCompare(b,'ko'));
}

const COMBO_DEFS = {
  type:  { label:'교과/종합',   tipMap: TYPE_TIP,  getAvail: getAvailTypes,  onChange: ()=>{ renderCombo('adm'); renderPivot(); } },
  track: { label:'인문/자연',   tipMap: TRACK_TIP, getAvail: getAvailTracks, onChange: ()=>{ renderPivot(); } },
  adm:   { label:'전형',        tipMap: null,       getAvail: getAvailAdms,   onChange: ()=>{ renderPivot(); } }
};

function getStateSet(kind){ return kind==='type' ? state.types : kind==='track' ? state.tracks : state.adms; }
function setStateSet(kind, s){ if(kind==='type') state.types = s; else if(kind==='track') state.tracks = s; else state.adms = s; }

function renderCombo(kind){
  const def = COMBO_DEFS[kind];
  const btn = document.getElementById('combo-' + kind + '-btn');
  const panel = document.getElementById('combo-' + kind + '-panel');

  if(state.univIdx===null){
    btn.textContent = def.label;
    btn.classList.remove('has-selection');
    panel.innerHTML = '';
    panel.classList.remove('open');
    return;
  }

  const avail = def.getAvail();
  let cur = getStateSet(kind);
  cur = new Set([...cur].filter(a => avail.includes(a)));
  setStateSet(kind, cur);

  btn.innerHTML = def.label + ' <span class="combo-count">' + cur.size + '/' + avail.length + '</span> <span class="combo-arrow">▾</span>';
  btn.classList.toggle('has-selection', cur.size > 0);

  if(avail.length===0){
    const msg = kind==='adm' ? '교과/종합을 먼저 선택하세요' : '선택 가능한 항목이 없어요';
    panel.innerHTML = '<div class="combo-empty">' + msg + '</div>';
    return;
  }

  let html = '<div class="combo-panel-head"><a data-op="all">전체선택</a><span>·</span><a data-op="none">전체해제</a></div>';
  avail.forEach(v=>{
    const checked = cur.has(v) ? 'checked' : '';
    const tip = def.tipMap && def.tipMap[v] ? ' title="' + escapeHtml(def.tipMap[v]) + '"' : '';
    html += '<label class="combo-item"' + tip + '><input type="checkbox" value="' + escapeHtml(v) + '" ' + checked + '> ' + escapeHtml(v) + '</label>';
  });
  panel.innerHTML = html;

  panel.querySelectorAll('a[data-op]').forEach(a=>{
    a.addEventListener('click', ()=>{
      const op = a.dataset.op;
      setStateSet(kind, op==='all' ? new Set(avail) : new Set());
      renderCombo(kind);
      // keep panel open after quick-select for convenience
      document.getElementById('combo-' + kind + '-panel').classList.add('open');
      def.onChange();
    });
  });
  panel.querySelectorAll('input[type=checkbox]').forEach(cb=>{
    cb.addEventListener('change', ()=>{
      const s = getStateSet(kind);
      if(cb.checked) s.add(cb.value); else s.delete(cb.value);
      btn.querySelector('.combo-count').textContent = s.size + '/' + avail.length;
      btn.classList.toggle('has-selection', s.size > 0);
      def.onChange();
    });
  });
}

function bindComboToggles(){
  ['type','track','adm'].forEach(kind=>{
    const btn = document.getElementById('combo-' + kind + '-btn');
    const panel = document.getElementById('combo-' + kind + '-panel');
    btn.addEventListener('click', (e)=>{
      e.stopPropagation();
      const isOpen = panel.classList.contains('open');
      document.querySelectorAll('.combo-panel.open').forEach(p=>p.classList.remove('open'));
      if(!isOpen) panel.classList.add('open');
    });
    panel.addEventListener('click', e=> e.stopPropagation());
  });
  document.addEventListener('click', ()=>{
    document.querySelectorAll('.combo-panel.open').forEach(p=>p.classList.remove('open'));
  });
}

// ---------- pivot table ----------
function buildYearSubheaderInto(elId){
  const tr = document.getElementById(elId);
  tr.innerHTML = '';
  const groups = ['g70','g50','cap','cr','rc'];
  groups.forEach(g=>{
    YEARS.forEach(y=>{
      const th = document.createElement('th');
      th.className = g;
      th.textContent = y;
      tr.appendChild(th);
    });
  });
}
function buildYearSubheader(){ buildYearSubheaderInto('year-subheader'); }

function renderPivot(){
  if(state.univIdx===null) return;
  const deptQ = state.deptSearch.trim().toLowerCase();
  const rows = ALL.filter(r=>
    r[C.UNIV]===state.univIdx &&
    YEARS.includes(r[C.YEAR]) &&
    state.types.has(TYPES[r[C.TYPE]]) &&
    state.tracks.has(TRACKS[r[C.TRACK]]) &&
    state.adms.has(ADMS[r[C.ADM]])
  );

  const combos = new Map(); // key: adm|dept -> {adm,dept,track,sub,years:{}}
  rows.forEach(r=>{
    const key = r[C.ADM] + '|' + r[C.DEPT];
    if(!combos.has(key)) combos.set(key, { univIdx:state.univIdx, admIdx:r[C.ADM], deptIdx:r[C.DEPT], track:r[C.TRACK], sub:r[C.SUB], years:{} });
    combos.get(key).years[r[C.YEAR]] = r;
  });

  let list = [...combos.values()];
  if(deptQ){
    list = list.filter(c => DEPTS[c.deptIdx].toLowerCase().includes(deptQ) || ADMS[c.admIdx].toLowerCase().includes(deptQ));
  }
  list.sort((a,b)=> (ADMS[a.admIdx]+DEPTS[a.deptIdx]).localeCompare(ADMS[b.admIdx]+DEPTS[b.deptIdx], 'ko'));

  document.getElementById('ch-title').textContent = UNIVS[state.univIdx];
  document.getElementById('ch-meta').textContent = list.length.toLocaleString() + '개 전형·학과 조합 · ' + univRegion[state.univIdx];

  buildYearSubheader();

  const tbody = document.getElementById('pivot-body');
  if(list.length===0){
    const nothingChosen = state.types.size===0 || state.tracks.size===0 || state.adms.size===0;
    const msg = nothingChosen
      ? '👆 대학 이름 옆의 [교과/종합] [인문/자연] [전형] 버튼을 눌러 보고 싶은 항목을 체크하세요. 체크한 항목만 표에 나타나요.'
      : '조건에 맞는 데이터가 없습니다. 위 필터를 확인해보세요.';
    tbody.innerHTML = '<tr><td colspan="16" style="text-align:center;padding:30px;color:#9aa0a8;">' + msg + '</td></tr>';
    return;
  }

  const html = list.map(c=>{
    const key = c.admIdx + '|' + c.deptIdx;
    const label = escapeHtml(ADMS[c.admIdx] + ' ' + DEPTS[c.deptIdx]);
    let cells = '';
    ['G70','G50','CAP','CR','RC'].forEach(field=>{
      const cls = {G70:'g70',G50:'g50',CAP:'cap',CR:'cr',RC:'rc'}[field];
      YEARS.forEach(y=>{
        const row = c.years[y];
        let val = '-';
        if(row){
          const raw = row[C[field]];
          if(raw!==null && raw!==undefined){
            val = (field==='CAP') ? raw : (+raw).toFixed(2);
          }
        }
        cells += `<td class="${cls}">${val}</td>`;
      });
    });
    const pinKey = state.univIdx + '|' + key;
    return `<tr data-key="${key}" class="${state.pinnedKey===pinKey ? 'selected' : ''}"><td class="rowlabel" title="${label}">${label}</td>${cells}</tr>`;
  }).join('');
  tbody.innerHTML = html;

  tbody.querySelectorAll('tr').forEach(tr=>{
    tr.addEventListener('click', ()=>{
      const key = tr.dataset.key;
      const combo = list.find(c => (c.admIdx+'|'+c.deptIdx)===key);
      if(combo) showDetail(combo);
    });
  });
}

// ---------- global cross-university department search ----------
function renderSearchRegionFilter(){
  const el = document.getElementById('search-region-filter');
  if(!el) return;
  el.innerHTML = '';
  REGIONS.forEach(r=>{
    const cls = REGION_GROUP[r] || '';
    const item = document.createElement('div');
    item.className = 'region-item ' + cls + (state.searchRegions.has(r) ? ' active' : '');
    item.textContent = r;
    item.addEventListener('click', ()=>{
      if(state.searchRegions.has(r)) state.searchRegions.delete(r); else state.searchRegions.add(r);
      renderSearchPivot();
    });
    el.appendChild(item);
  });
}

function setSearchSort(mode){
  state.searchSortBy = mode;
  document.getElementById('sort-univ-btn').classList.toggle('active', mode==='univ');
  document.getElementById('sort-region-btn').classList.toggle('active', mode==='region');
  renderSearchPivot();
}

function renderSearchPivot(){
  const q = state.globalDeptQuery.trim().toLowerCase();
  const metaEl = document.getElementById('search-meta');
  const tbody = document.getElementById('search-pivot-body');

  buildYearSubheaderInto('search-year-subheader');
  renderSearchRegionFilter();

  if(!q){
    metaEl.textContent = '학과명을 입력하면 전체 대학의 결과를 보여드려요. (예: 간호학과, 컴퓨터공학, 경영학)';
    tbody.innerHTML = '<tr><td colspan="16" style="text-align:center;padding:30px;color:#9aa0a8;">🔍 위 검색창에 학과명을 입력해보세요</td></tr>';
    return;
  }

  const rows = ALL.filter(r => YEARS.includes(r[C.YEAR]) && DEPTS[r[C.DEPT]].toLowerCase().includes(q) && (state.searchRegions.size===0 || state.searchRegions.has(REGIONS[r[C.REG]])));

  const combos = new Map(); // key: univ|adm|dept -> {univIdx,admIdx,deptIdx,track,sub,years:{}}
  rows.forEach(r=>{
    const key = r[C.UNIV] + '|' + r[C.ADM] + '|' + r[C.DEPT];
    if(!combos.has(key)) combos.set(key, { univIdx:r[C.UNIV], admIdx:r[C.ADM], deptIdx:r[C.DEPT], track:r[C.TRACK], sub:r[C.SUB], years:{} });
    combos.get(key).years[r[C.YEAR]] = r;
  });

  let list = [...combos.values()];
  if(state.searchSortBy === 'region'){
    list.sort((a,b)=>{
      const ra = REGIONS.indexOf(univRegion[a.univIdx]), rb = REGIONS.indexOf(univRegion[b.univIdx]);
      if(ra !== rb) return ra - rb;
      return (UNIVS[a.univIdx]+ADMS[a.admIdx]+DEPTS[a.deptIdx]).localeCompare(UNIVS[b.univIdx]+ADMS[b.admIdx]+DEPTS[b.deptIdx], 'ko');
    });
  } else {
    list.sort((a,b)=> (UNIVS[a.univIdx]+ADMS[a.admIdx]+DEPTS[a.deptIdx]).localeCompare(UNIVS[b.univIdx]+ADMS[b.admIdx]+DEPTS[b.deptIdx], 'ko'));
  }

  if(list.length===0){
    metaEl.textContent = '"' + q + '"에 해당하는 학과를 찾을 수 없습니다.';
    tbody.innerHTML = '<tr><td colspan="16" style="text-align:center;padding:30px;color:#9aa0a8;">조건에 맞는 학과가 없습니다. 다른 검색어를 입력해보세요.</td></tr>';
    return;
  }

  const univCount = new Set(list.map(c=>c.univIdx)).size;
  const filterNote = state.searchRegions.size > 0 ? ' (지역 필터 적용중: ' + [...state.searchRegions].join(', ') + ')' : '';
  metaEl.textContent = univCount.toLocaleString() + '개 대학 · ' + list.length.toLocaleString() + '개 전형·학과 조합' + filterNote;

  const html = list.map(c=>{
    const key = c.univIdx + '|' + c.admIdx + '|' + c.deptIdx;
    const label = escapeHtml(UNIVS[c.univIdx] + ' (' + univRegion[c.univIdx] + ') · ' + ADMS[c.admIdx] + ' ' + DEPTS[c.deptIdx]);
    let cells = '';
    ['G70','G50','CAP','CR','RC'].forEach(field=>{
      const cls = {G70:'g70',G50:'g50',CAP:'cap',CR:'cr',RC:'rc'}[field];
      YEARS.forEach(y=>{
        const row = c.years[y];
        let val = '-';
        if(row){
          const raw = row[C[field]];
          if(raw!==null && raw!==undefined){
            val = (field==='CAP') ? raw : (+raw).toFixed(2);
          }
        }
        cells += `<td class="${cls}">${val}</td>`;
      });
    });
    return `<tr data-key="${key}" class="${state.pinnedKey===key ? 'selected' : ''}"><td class="rowlabel" title="${label}">${label}</td>${cells}</tr>`;
  }).join('');
  tbody.innerHTML = html;

  tbody.querySelectorAll('tr').forEach(tr=>{
    tr.addEventListener('click', ()=>{
      const key = tr.dataset.key;
      const combo = list.find(c => (c.univIdx+'|'+c.admIdx+'|'+c.deptIdx)===key);
      if(combo) showDetail(combo);
    });
  });
}

function switchView(view){
  state.activeView = view;
  document.getElementById('univ-view').style.display = (view==='univ') ? '' : 'none';
  document.getElementById('search-view').style.display = (view==='search') ? '' : 'none';
  document.getElementById('ladder-view').style.display = (view==='ladder') ? '' : 'none';
  document.getElementById('jeongsi-view').style.display = (view==='jeongsi') ? '' : 'none';
  document.getElementById('dualmajor-view').style.display = (view==='dualmajor') ? '' : 'none';
  document.getElementById('tab-univ').classList.toggle('active', view==='univ');
  document.getElementById('tab-search').classList.toggle('active', view==='search');
  document.getElementById('tab-ladder').classList.toggle('active', view==='ladder');
  document.getElementById('tab-jeongsi').classList.toggle('active', view==='jeongsi');
  document.getElementById('tab-dualmajor').classList.toggle('active', view==='dualmajor');
  closeDetail();
  if(view==='search'){
    renderSearchPivot();
    const box = document.getElementById('f-global-dept-search');
    if(box) box.focus();
  } else if(view==='ladder' && window.LadderApp){
    window.LadderApp.renderAll();
  }
}

// ---------- detail chart on row click ----------
let detailChart = null;
function showDetail(combo){
  const univIdx = (combo.univIdx !== undefined && combo.univIdx !== null) ? combo.univIdx : state.univIdx;
  state.pinnedKey = univIdx + '|' + combo.admIdx + '|' + combo.deptIdx;
  if(state.activeView==='univ') renderPivot();
  else renderSearchPivot();
  const panel = document.getElementById('detail-panel');
  panel.classList.add('show');
  document.getElementById('detail-title').textContent = UNIVS[univIdx] + ' · ' + ADMS[combo.admIdx] + ' ' + DEPTS[combo.deptIdx];
  document.getElementById('detail-meta').textContent = TRACKS[combo.track] + (combo.sub!==null ? ' · ' + SUBDEPTS[combo.sub] : '');

  const g50 = CHART_YEARS.map(y=> combo.years[y] && combo.years[y][C.G50]!=null ? combo.years[y][C.G50] : null);
  const g70 = CHART_YEARS.map(y=> combo.years[y] && combo.years[y][C.G70]!=null ? combo.years[y][C.G70] : null);
  const cr  = CHART_YEARS.map(y=> combo.years[y] && combo.years[y][C.CR]!=null  ? combo.years[y][C.CR]  : null);
  const ctx = document.getElementById('chart-detail').getContext('2d');
  try{
    if(detailChart) detailChart.destroy();
    detailChart = new Chart(ctx, {
      type:'line',
      data:{ labels: CHART_YEARS, datasets:[
        { label:'등급50컷', data:g50, borderColor:'#3b5bdb', backgroundColor:'#3b5bdb20', borderWidth:2, spanGaps:true, tension:.25, pointRadius:4, yAxisID:'y' },
        { label:'등급70컷', data:g70, borderColor:'#e8590c', backgroundColor:'#e8590c20', borderWidth:2, spanGaps:true, tension:.25, pointRadius:4, yAxisID:'y' },
        { label:'경쟁률', data:cr, borderColor:'#2f9e63', backgroundColor:'#2f9e6320', borderWidth:2, borderDash:[6,3], spanGaps:true, tension:.25, pointRadius:4, yAxisID:'y1' }
      ]},
      options:{
        responsive:true, maintainAspectRatio:false,
        plugins:{legend:{position:'top'}},
        scales:{
          y:{ reverse:true, position:'left', title:{display:true,text:'등급 (낮을수록 상위권)'} },
          y1:{ reverse:false, position:'right', beginAtZero:true, title:{display:true,text:'경쟁률'}, grid:{drawOnChartArea:false} }
        }
      }
    });
  }catch(e){ console.warn('detail chart failed', e); }

  const tbody = document.querySelector('#detail-table tbody');
  tbody.innerHTML = YEARS.map(y=>{
    const row = combo.years[y];
    const cap = row && row[C.CAP]!=null ? row[C.CAP] : '-';
    const crv = row && row[C.CR]!=null ? (+row[C.CR]).toFixed(2) : '-';
    const chv = row && row[C.CH]!=null ? row[C.CH] : '-';
    const g50v = row && row[C.G50]!=null ? (+row[C.G50]).toFixed(2) : '-';
    const g70v = row && row[C.G70]!=null ? (+row[C.G70]).toFixed(2) : '-';
    return '<tr><td class="dyear">' + y + '</td><td>' + cap + '</td><td>' + crv + '</td><td>' + chv + '</td><td>' + g50v + '</td><td>' + g70v + '</td></tr>';
  }).join('');

  if(typeof panel.scrollIntoView === 'function'){ try{ panel.scrollIntoView({behavior:'smooth', block:'nearest'}); }catch(e){} }
}

function closeDetail(){
  state.pinnedKey = null;
  document.getElementById('detail-panel').classList.remove('show');
}

// ---------- init ----------
function showInitError(label, e){
  let banner = document.getElementById('init-error-banner');
  if(!banner){
    banner = document.createElement('div');
    banner.id = 'init-error-banner';
    banner.style.cssText = 'background:#fdeaea;border:1px solid #f3b9b9;color:#c0392b;padding:10px 16px;border-radius:8px;margin-bottom:12px;font-size:12.5px;font-weight:600;line-height:1.6;';
    const container = document.querySelector('.container');
    if(container) container.insertBefore(banner, container.firstChild);
  }
  const msg = (e && e.message) ? e.message : String(e);
  banner.textContent += (banner.textContent ? ' / ' : '⚠️ 일부 기능 로딩 중 오류가 발생했어요 (화면을 새로고침해보세요): ') + label + ' - ' + msg;
}

function safeRun(label, fn){
  try{ fn(); }
  catch(e){
    console.error('[init:' + label + ']', e);
    showInitError(label, e);
  }
}

function init(){
  safeRun('지역목록', renderRegionList);
  safeRun('대학목록', renderUnivList);
  safeRun('대학이동버튼', populateHeaderSelect);
  safeRun('필터버튼바인딩', bindComboToggles);
  safeRun('교과종합필터', ()=>renderCombo('type'));
  safeRun('인문자연필터', ()=>renderCombo('track'));
  safeRun('전형필터', ()=>renderCombo('adm'));

  safeRun('대학검색바인딩', ()=>{
    document.getElementById('f-univ-search').addEventListener('input', e=>{
      state.univSearch = e.target.value;
      renderUnivList();
    });
  });
  safeRun('학과검색바인딩', ()=>{
    document.getElementById('f-dept-search').addEventListener('input', e=>{
      state.deptSearch = e.target.value;
      renderPivot();
    });
  });
  safeRun('상세닫기바인딩', ()=>{
    document.getElementById('detail-close').addEventListener('click', closeDetail);
  });
  safeRun('탭전환바인딩', ()=>{
    document.getElementById('tab-univ').addEventListener('click', ()=>{ try{ switchView('univ'); }catch(e){ console.error('[switchView]', e); showInitError('탭전환', e); } });
    document.getElementById('tab-search').addEventListener('click', ()=>{ try{ switchView('search'); }catch(e){ console.error('[switchView]', e); showInitError('탭전환', e); } });
    document.getElementById('tab-ladder').addEventListener('click', ()=>{ try{ switchView('ladder'); }catch(e){ console.error('[switchView]', e); showInitError('탭전환', e); } });
    document.getElementById('tab-jeongsi').addEventListener('click', ()=>{ try{ switchView('jeongsi'); }catch(e){ console.error('[switchView]', e); showInitError('탭전환', e); } });
    document.getElementById('tab-dualmajor').addEventListener('click', ()=>{ try{ switchView('dualmajor'); }catch(e){ console.error('[switchView]', e); showInitError('탭전환', e); } });
  });
  safeRun('학과전체검색바인딩', ()=>{
    document.getElementById('f-global-dept-search').addEventListener('input', e=>{
      try{
        state.globalDeptQuery = e.target.value;
        renderSearchPivot();
      }catch(err){ console.error('[학과전체검색]', err); showInitError('학과전체검색', err); }
    });
  });
  safeRun('학과검색정렬바인딩', ()=>{
    document.getElementById('sort-univ-btn').addEventListener('click', ()=>{ try{ setSearchSort('univ'); }catch(e){ console.error('[정렬]', e); showInitError('정렬', e); } });
    document.getElementById('sort-region-btn').addEventListener('click', ()=>{ try{ setSearchSort('region'); }catch(e){ console.error('[정렬]', e); showInitError('정렬', e); } });
  });
}

try{
  init();
}catch(e){
  console.error('init() fatal error', e);
  try{ showInitError('초기화', e); }catch(e2){}
}
</script>
<script>
(function(){
  // 이 페이지의 기존 전역(ALL, C, TYPES, TRACKS, UNIVS, REGIONS, DEPTS, SUBDEPTS, ADMS)을 그대로 재사용해서
  // "합격선 사다리" 탭 전용 데이터를 이 자리에서 새로 계산한다. (3개년 커트라인 수기 파일은 사용하지 않음)
  const TYPE_G = TYPES.indexOf('교과'), TYPE_J = TYPES.indexOf('종합');
  const TRACK_I = TRACKS.indexOf('인문'), TRACK_J = TRACKS.indexOf('자연'), TRACK_MED = TRACKS.indexOf('의학');
  const YEARS_OK = new Set([2024,2025,2026]);

  // Fisher-Jenks 자연구간 분할 (표준 동적계획법 구현)
  function jenksBreaks(data, n_classes){
    data = data.slice().sort((a,b)=>a-b);
    const n = data.length;
    if(n_classes >= n) return [data[0], data[n-1]];
    const mat1 = [], mat2 = [];
    for(let i=0;i<=n;i++){
      mat1.push(new Array(n_classes+1).fill(0));
      mat2.push(new Array(n_classes+1).fill(0));
    }
    for(let i=1;i<=n_classes;i++){
      mat1[1][i]=1; mat2[1][i]=0;
      for(let j=2;j<=n;j++) mat2[j][i]=Infinity;
    }
    let v=0;
    for(let l=2;l<=n;l++){
      let s1=0,s2=0,w=0;
      for(let m=1;m<=l;m++){
        const i3=l-m+1;
        const val=data[i3-1];
        w++; s1+=val; s2+=val*val;
        v = s2-(s1*s1)/w;
        const i4=i3-1;
        if(i4!==0){
          for(let j=2;j<=n_classes;j++){
            if(mat2[l][j] >= v+mat2[i4][j-1]){
              mat1[l][j]=i3; mat2[l][j]=v+mat2[i4][j-1];
            }
          }
        }
      }
      mat1[l][1]=1; mat2[l][1]=v;
    }
    const kclass = new Array(n_classes+1).fill(0);
    kclass[n_classes] = data[n-1];
    kclass[0] = data[0];
    let k = n, countNum = n_classes;
    while(countNum>1){
      const idx = mat1[k][countNum]-2;
      kclass[countNum-1] = data[idx];
      k = mat1[k][countNum]-1;
      countNum--;
    }
    return kclass;
  }

  function buildLadderPayload(){
    const base = [];
    for(const r of ALL){
      const typeIdx = r[C.TYPE], trackIdx = r[C.TRACK];
      if(typeIdx!==TYPE_G && typeIdx!==TYPE_J) continue;
      if(trackIdx!==TRACK_I && trackIdx!==TRACK_J && trackIdx!==TRACK_MED) continue;
      if(!YEARS_OK.has(r[C.YEAR])) continue;
      const cap = r[C.CAP];
      if(cap===0) continue; // 모집인원 0(예정) 행 제외
      const g50 = (r[C.G50]!=null && !isNaN(r[C.G50])) ? r[C.G50] : null;
      const g70 = (r[C.G70]!=null && !isNaN(r[C.G70])) ? r[C.G70] : null;
      if(g50==null && g70==null) continue;
      const cutVals = []; if(g50!=null) cutVals.push(g50); if(g70!=null) cutVals.push(g70);
      const cut = cutVals.reduce((a,b)=>a+b,0)/cutVals.length;
      base.push({
        univ: r[C.UNIV], region: r[C.REG], year: r[C.YEAR],
        track: trackIdx===TRACK_I ? 0 : (trackIdx===TRACK_J ? 1 : 2),
        admtype: typeIdx===TYPE_G ? 0 : 1,
        adm: r[C.ADM], dept: r[C.DEPT], subdept: (r[C.SUB]!=null ? r[C.SUB] : -1),
        cap, g50, g70, cr: r[C.CR], cut,
      });
    }

    // 등급이 전부 1.00으로 찍힌 오류 그룹(대학×연도×전형유형, n>=3) 제외
    const groupMap = new Map();
    base.forEach(o=>{
      const key = o.univ+'|'+o.year+'|'+o.admtype;
      if(!groupMap.has(key)) groupMap.set(key, []);
      groupMap.get(key).push(o.cut);
    });
    const badGroups = new Set();
    groupMap.forEach((cuts,key)=>{
      if(cuts.length>=3 && cuts.every(c=>c===1.0)) badGroups.add(key);
    });
    const rows = base.filter(o => !badGroups.has(o.univ+'|'+o.year+'|'+o.admtype));

    // 정적 군 계산: 인문×교과/종합, 자연×교과/종합(사용자가 처음 정한 12~16개 실무형 세분화),
    // 그리고 의치한약수×교과/종합(대학 수가 훨씬 적어 개수에 맞춰 자동으로 군 수를 정함)
    const groupsK = {'0_0':16, '1_0':14, '0_1':12, '1_1':12};
    const tiers = {};
    [[0,0],[1,0],[0,1],[1,1],[2,0],[2,1]].forEach(([track,admtype])=>{
      const key = track+'_'+admtype;
      const subset = rows.filter(r=>r.track===track && r.admtype===admtype);
      const byUniv = new Map();
      subset.forEach(r=>{
        if(!byUniv.has(r.univ)) byUniv.set(r.univ, {cuts:[], depts:new Set(), regionCount:new Map()});
        const o = byUniv.get(r.univ);
        o.cuts.push(r.cut);
        o.depts.add(r.dept);
        o.regionCount.set(r.region, (o.regionCount.get(r.region)||0)+1);
      });
      const list = [];
      byUniv.forEach((o,u)=>{
        const sorted = o.cuts.slice().sort((a,b)=>a-b);
        const mid = Math.floor(sorted.length/2);
        const median = sorted.length%2 ? sorted[mid] : (sorted[mid-1]+sorted[mid])/2;
        let bestRegion=null, bestCount=-1;
        o.regionCount.forEach((cnt,reg)=>{ if(cnt>bestCount){ bestCount=cnt; bestRegion=reg; } });
        list.push({ u, univ:UNIVS[u], cut:median, ndept:o.depts.size, region:REGIONS[bestRegion] });
      });
      if(list.length===0){ tiers[key] = { k:0, breaks:[], entries:[] }; return; }
      list.sort((a,b)=>a.cut-b.cut);
      list.forEach((e,i)=>e.rank=i+1);
      const kWanted = groupsK[key] !== undefined ? groupsK[key] : Math.max(2, Math.min(16, Math.round(list.length/6)));
      const vals = list.map(e=>e.cut);
      const k = Math.max(2, Math.min(kWanted, vals.length));
      const breaks = jenksBreaks(vals, k);
      list.forEach(e=>{
        let tier = breaks.length-1;
        for(let i=0;i<breaks.length-1;i++){
          const lo=breaks[i], hi=breaks[i+1];
          if((i===0 && e.cut>=lo && e.cut<=hi) || (e.cut>lo && e.cut<=hi)){ tier=i+1; break; }
        }
        e.tier = tier;
      });
      tiers[key] = { k: breaks.length-1, breaks, entries:list };
    });

    return { univs:UNIVS, regions:REGIONS, depts:DEPTS, subdepts:SUBDEPTS, rows, tiers };
  }

  const P = buildLadderPayload();

  // 대학 필터 콤보박스용 정렬된 목록 (한글 가나다순)
  const univFilterList = P.univs.map((u,i)=>({name:u, idx:i})).sort((a,b)=>a.name.localeCompare(b.name,'ko'));

  const state = {
    track: 0, admtype: 0, mainTab: 'match',
    allAvg: null, coreAvg: null, majorQuery: '',
    regions: new Set(), marginSafe: 0.3, marginReach: 0.7,
    refUniv: null, sortKey: 'cut', sortDir: 1,
    univs: new Set(), selectedDepts: new Set(),
  };

  // 학과 매칭 표에서 지금 화면에 그려진 행들을 인덱스로 들고 있다가, 행 클릭 시 그 인덱스로 원본 데이터를 되찾아
  // 미니 상세 팝업을 연다 (DOM에 전체 객체를 박아넣지 않고 참조만 유지).
  let renderedEntries = [];

  // 상향/소신/적정/안정 → 배지 CSS 클래스 접미사 (한글 클래스명 대신 안전한 영문 키로 매핑)
  const KLASS_CSS = { '상향':'reach', '소신':'bold', '적정':'match', '안정':'safe' };

  // ---------- 관심대학 북마크 (localStorage, 서버 없이 이 브라우저에 즉시 영속 저장) ----------
  const FAV_KEY = 'ladderFavorites_v1';
  function loadFavorites(){
    try{
      const raw = localStorage.getItem(FAV_KEY);
      const list = raw ? JSON.parse(raw) : [];
      return Array.isArray(list) ? list : [];
    }catch(e){ return []; }
  }
  function saveFavoritesList(list){
    try{ localStorage.setItem(FAV_KEY, JSON.stringify(list)); }catch(e){ /* 저장 공간 문제 등은 조용히 무시 */ }
  }
  function favKey(f){ return f.univ+'|'+f.dept+'|'+(f.subdept||''); }
  function isFavorited(snap){ return loadFavorites().some(f=>favKey(f)===favKey(snap)); }
  function toggleFavorite(snap){
    const list = loadFavorites();
    const key = favKey(snap);
    const idx = list.findIndex(f=>favKey(f)===key);
    if(idx>=0){ list.splice(idx,1); saveFavoritesList(list); return false; }
    list.push(Object.assign({}, snap, { savedAt: Date.now() }));
    saveFavoritesList(list);
    return true;
  }

  // ---------- 정렬 ----------
  function sortComparator(key, dir){
    return (a,b)=>{
      let av, bv;
      switch(key){
        case 'univ': av=P.univs[a.univ]; bv=P.univs[b.univ]; return dir*av.localeCompare(bv,'ko');
        case 'dept': av=P.depts[a.dept]; bv=P.depts[b.dept]; return dir*av.localeCompare(bv,'ko');
        case 'region': av=P.regions[a.region]; bv=P.regions[b.region]; return dir*av.localeCompare(bv,'ko');
        case 'tier': av=a.tier||9999; bv=b.tier||9999; return dir*(av-bv);
        case 'volatility': av=(a.volatility==null?-1:a.volatility); bv=(b.volatility==null?-1:b.volatility); return dir*(av-bv);
        case 'year': av=a.repYear||0; bv=b.repYear||0; return dir*(av-bv);
        case 'cut': default: return dir*(a.cut-b.cut);
      }
    };
  }
  function sortArrow(key){
    if(state.sortKey!==key) return '';
    return state.sortDir===1 ? ' ▲' : ' ▼';
  }

  // ---------- 미니 스파크라인(SVG) — 최근 3개년 합격선/경쟁률 추이를 팝업에 그릴 때 사용 ----------
  // vals: [{label, value|null}, ...] · 색상은 CSS 변수 대신 고정 hex를 써서(=인라인 SVG 속성 안에서도 항상 안전하게 렌더)
  function sparkLine(vals, w, h){
    const valid = vals.filter(v=>v.value!=null).map(v=>v.value);
    if(valid.length===0) return '<div class="spark-empty">자료 없음</div>';
    const lo = Math.min(...valid), hi = Math.max(...valid);
    const span = (hi-lo) || 1;
    const n = vals.length;
    const stepX = n>1 ? (w-16)/(n-1) : 0;
    const pts = vals.map((v,i)=>{
      if(v.value==null) return null;
      const x = 8+i*stepX;
      // 등급은 낮을수록(=성적이 좋을수록) 위로 오게 뒤집는다 (사다리 탭의 다른 축과 방향을 통일)
      const y = 8 + (v.value-lo)/span*(h-16);
      return {x,y};
    });
    let path = '', started = false;
    pts.forEach(p=>{
      if(!p){ started=false; return; }
      path += (started?'L':'M') + p.x.toFixed(1) + ' ' + p.y.toFixed(1) + ' ';
      started = true;
    });
    const circles = pts.map(p=> p ? `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="2.6" fill="#2f4858"></circle>` : '').join('');
    const labels = vals.map((v,i)=> `<text x="${(8+i*stepX).toFixed(1)}" y="${h-1}" font-size="9" text-anchor="middle" fill="#51625f">${v.label}</text>`).join('');
    const valueLabels = vals.map((v,i)=>{
      if(v.value==null) return '';
      const x = 8+i*stepX;
      const y = 8 + (v.value-lo)/span*(h-16) - 5;
      return `<text x="${x.toFixed(1)}" y="${y.toFixed(1)}" font-size="9" text-anchor="middle" fill="#2f4858">${v.value.toFixed(2)}</text>`;
    }).join('');
    return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" class="mini-spark"><path d="${path.trim()}" fill="none" stroke="#4d6a7c" stroke-width="1.6"/>${circles}${valueLabels}${labels}</svg>`;
  }
  function sparkBar(vals, w, h){
    const valid = vals.filter(v=>v.value!=null).map(v=>v.value);
    if(valid.length===0) return '<div class="spark-empty">자료 없음</div>';
    const hi = Math.max(...valid, 0.0001);
    const n = vals.length;
    const gap = 6;
    const barW = (w-16-(n-1)*gap)/n;
    let bars = '', valueLabels = '';
    vals.forEach((v,i)=>{
      const x = 8+i*(barW+gap);
      if(v.value==null){
        bars += `<text x="${(x+barW/2).toFixed(1)}" y="${h-12}" font-size="9" text-anchor="middle" fill="#51625f">-</text>`;
        return;
      }
      const bh = (v.value/hi)*(h-22);
      const y = h-12-bh;
      bars += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${Math.max(bh,1).toFixed(1)}" fill="#a8781f" rx="1.5"></rect>`;
      valueLabels += `<text x="${(x+barW/2).toFixed(1)}" y="${(y-3).toFixed(1)}" font-size="9" text-anchor="middle" fill="#2f4858">${v.value.toFixed(1)}</text>`;
    });
    const labels = vals.map((v,i)=> `<text x="${(8+i*(barW+gap)+barW/2).toFixed(1)}" y="${h-1}" font-size="9" text-anchor="middle" fill="#51625f">${v.label}</text>`).join('');
    return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" class="mini-spark">${bars}${valueLabels}${labels}</svg>`;
  }

  function axisKey(track, admtype){ return track + '_' + admtype; }

  function matchedSubdeptIdx(query){
    const q = query.trim();
    if(!q) return null;
    const out = new Set();
    P.subdepts.forEach((s,i)=>{ if(s!=null && (String(s).includes(q) || q.includes(String(s)))) out.add(i); });
    return out;
  }
  function matchedDeptIdx(query){
    const q = query.trim();
    if(!q) return null;
    const out = new Set();
    P.depts.forEach((d,i)=>{ if(d!=null && String(d).includes(q)) out.add(i); });
    return out;
  }

  // ---------- 대학 다중선택 필터 콤보박스 ----------
  function renderUnivFilterList(filterText){
    const q = (filterText||'').trim();
    const listEl = document.getElementById('lUnivFilterList');
    const items = q ? univFilterList.filter(o=>o.name.includes(q)) : univFilterList;
    listEl.innerHTML = items.map(o=>`
      <label class="lcombo-item">
