  // ---------- 희망학과 검색어에 매칭된 모집단위(학과)를 체크박스로 보여주는 보조 목록 ----------
  function renderDeptChecklist(){
    const el = document.getElementById('lDeptChecklist');
    const dm = matchedDeptIdx(state.majorQuery);
    if(!dm || dm.size===0){ el.classList.remove('open'); el.innerHTML=''; return; }
    const counts = new Map();
    P.rows.forEach(r=>{
      if(r.track!==state.track || r.admtype!==state.admtype) return;
      if(dm.has(r.dept)) counts.set(r.dept, (counts.get(r.dept)||0)+1);
    });
    const items = [...dm].filter(i=>counts.has(i)).sort((a,b)=> P.depts[a].localeCompare(P.depts[b],'ko'));
    if(items.length===0){ el.classList.remove('open'); el.innerHTML=''; return; }
    el.innerHTML = items.map(i=>`
      <label>
        <input type="checkbox" value="${i}" ${state.selectedDepts.has(i)?'checked':''}>
        <span>${P.depts[i]}</span>
        <span class="cnt">${counts.get(i)}건</span>
      </label>
    `).join('');
    el.classList.add('open');
  }

  function filteredRows(){
    const subMatch = matchedSubdeptIdx(state.majorQuery);
    const deptMatch = matchedDeptIdx(state.majorQuery);
    const hasQuery = !!state.majorQuery.trim();
    const regionOn = state.regions.size>0;
    const univOn = state.univs.size>0;
    const out = [];
    for(const r of P.rows){
      if(r.track!==state.track) continue;
      if(r.admtype!==state.admtype) continue;
      if(regionOn && !state.regions.has(P.regions[r.region])) continue;
      if(univOn && !state.univs.has(P.univs[r.univ])) continue;
      if(hasQuery){
        const sIn = r.subdept>=0 && subMatch && subMatch.has(r.subdept);
        const dIn = deptMatch && deptMatch.has(r.dept);
        if(!sIn && !dIn) continue;
        if(state.selectedDepts.size>0 && !state.selectedDepts.has(r.dept)) continue;
      }
      out.push(r);
    }
    return out;
  }

  function groupRows(rows){
    const map = new Map();
    for(const r of rows){
      const key = r.univ+'|'+r.dept;
      let g = map.get(key);
      if(!g){ g = { univ:r.univ, dept:r.dept, subdept:r.subdept, region:r.region, years:{} }; map.set(key,g); }
      g.years[r.year] = { g50:r.g50, g70:r.g70, cr:r.cr, cap:r.cap, adm:r.adm };
    }
    const out = [];
    map.forEach(g=>{
      let repYear = null, rep = null;
      for(const y of [2026,2025,2024]){
        const yy = g.years[y];
        if(yy && (yy.g50!=null || yy.g70!=null)){ repYear=y; rep=yy; break; }
      }
      if(!rep) return;
      const cutVals = [rep.g50, rep.g70].filter(v=>v!=null);
      const cut = cutVals.reduce((a,b)=>a+b,0)/cutVals.length;

      // 최근 3개년(2024~2026) 컷의 변동성(표준편차) — 같은 여유 폭(0.3/0.7)이라도
      // 해마다 컷이 크게 흔들리는 학과인지, 거의 안 흔들리는 학과인지 구분해서 보여주기 위함
      const yearCuts = [];
      [2024,2025,2026].forEach(y=>{
        const yy = g.years[y];
        if(yy){
          const vals = [yy.g50, yy.g70].filter(v=>v!=null);
          if(vals.length) yearCuts.push(vals.reduce((a,b)=>a+b,0)/vals.length);
        }
      });
      let volatility = null;
      if(yearCuts.length>=2){
        const m = yearCuts.reduce((a,b)=>a+b,0)/yearCuts.length;
        const variance = yearCuts.reduce((a,b)=>a+(b-m)*(b-m),0)/yearCuts.length;
        volatility = Math.sqrt(variance);
      }

      out.push({ univ:g.univ, dept:g.dept, subdept:g.subdept, region:g.region, years:g.years, repYear, cut, volatility, volN:yearCuts.length });
    });
    return out;
  }

  function volatilityTag(volatility, volN){
    if(volatility==null) return { text: volN<=1 ? '자료 1개년' : '-', cls:'vol-na' };
    if(volatility <= 0.15) return { text:'±'+volatility.toFixed(2)+' 안정적', cls:'vol-low' };
    if(volatility <= 0.35) return { text:'±'+volatility.toFixed(2)+' 보통', cls:'vol-mid' };
    return { text:'±'+volatility.toFixed(2)+' 변동 큼', cls:'vol-high' };
  }

  // 희망학과가 입력된 경우: 그 학과만으로 대학 군을 새로 계산 (전체 학과 평균이 아니라 이 학과 기준 사다리)
  // 학과를 지정한 동적 사다리는 대학 수가 적을 때 Jenks 자연구간이 몇 개 안 되는 넓은 군을 만들기 쉬워서
  // (예: 20개교인데 3개 군, 한 군이 2~3등급대씩 벌어짐) 자연구간 대신 등급 고정 간격으로 군을 나눈다.
  // 다만 아주 상위권(1.0~2.0등급대)은 그 안에서도 대학 간 체감 차이가 크기 때문에, 그 구간만 더 촘촘한
  // 간격(0.25)을 쓰고 나머지는 기존 0.5 간격을 그대로 쓰는 "구간별 다른 폭" 방식으로 나눈다.
  function tieredWidthBreaks(vals, fineWidth, fineCutoff, coarseWidth){
    const lo = Math.min(...vals), hi = Math.max(...vals);
    const breaks = [];
    if(lo < fineCutoff){
      let v = Math.floor(lo/fineWidth)*fineWidth;
      breaks.push(+v.toFixed(2));
      const fineEnd = Math.min(hi, fineCutoff);
      while(v < fineEnd - 1e-9){
        v += fineWidth;
        breaks.push(+Math.min(v, fineCutoff).toFixed(2));
      }
      if(hi <= fineCutoff) return breaks;
      if(breaks[breaks.length-1] < fineCutoff) breaks.push(+fineCutoff.toFixed(2));
    } else {
      breaks.push(+(Math.floor(lo/coarseWidth)*coarseWidth).toFixed(2));
    }
    let v = breaks[breaks.length-1];
    const end = Math.ceil(hi/coarseWidth)*coarseWidth;
    while(v < end - 1e-9){
      v += coarseWidth;
      breaks.push(+v.toFixed(2));
    }
    return breaks;
  }

  function buildDynamicTiers(){
    const rows = filteredRows();
    const byUniv = new Map();
    rows.forEach(r=>{
      const cutVals = [r.g50, r.g70].filter(v=>v!=null);
      if(cutVals.length===0) return;
      const cut = cutVals.reduce((a,b)=>a+b,0)/cutVals.length;
      const u = r.univ;
      if(!byUniv.has(u)) byUniv.set(u, {cuts:[], region:r.region, depts:new Set()});
      const o = byUniv.get(u);
      o.cuts.push(cut);
      o.depts.add(r.dept);
    });
    const list = [];
    byUniv.forEach((o,u)=>{
      const sorted = o.cuts.slice().sort((a,b)=>a-b);
      const mid = Math.floor(sorted.length/2);
      const median = sorted.length%2 ? sorted[mid] : (sorted[mid-1]+sorted[mid])/2;
      list.push({ u, univ:P.univs[u], cut:median, ndept:o.depts.size, region:P.regions[o.region] });
    });
    if(list.length===0) return null;
    list.sort((a,b)=>a.cut-b.cut);
    list.forEach((e,i)=>e.rank=i+1);

    const n = list.length;
    const breaks = tieredWidthBreaks(list.map(e=>e.cut), 0.25, 2.0, 0.5);
    const k = breaks.length-1;
    list.forEach(e=>{
      let tier = k;
      for(let i=0;i<breaks.length-1;i++){
        const lo=breaks[i], hi=breaks[i+1];
        if((i===0 && e.cut>=lo && e.cut<=hi) || (e.cut>lo && e.cut<=hi)){ tier=i+1; break; }
      }
      e.tier = tier;
    });
    return { k, breaks, entries:list, n };
  }

  function tierLookup(track, admtype){
    const key = axisKey(track, admtype);
    const t = P.tiers[key];
    const map = new Map();
    t.entries.forEach(e=> map.set(e.u, e));
    return { table:t, map };
  }

  // 교과전형(국영수사/국영수과/주요과목)·종합전형(전과목) 중 지금 어떤 등급이 쓰이는지 이름표를 만든다.
  function coreLabelText(){
    return state.track===0 ? '국영수사 평균등급' : (state.track===1 ? '국영수과 평균등급' : '주요과목 평균등급');
  }

  // 학생 등급 입력칸의 "지금 화면에 보이는 값"을 그대로 읽어온다.
  // (state.allAvg/state.coreAvg 캐시가 어떤 이유로든 입력칸과 어긋나면 두 패널(정밀 비교 vs 사다리)에
  //  서로 다른 학생 등급이 표시되는 문제가 생길 수 있어, 매 렌더마다 DOM에서 직접 다시 읽어 일치시킨다.)
  function getStudentVal(){
    const coreEl = document.getElementById('lCoreAvg');
    const allEl = document.getElementById('lAllAvg');
    const coreV = coreEl && coreEl.value.trim() !== '' ? parseFloat(coreEl.value) : null;
    const allV = allEl && allEl.value.trim() !== '' ? parseFloat(allEl.value) : null;
    return state.admtype===0 ? coreV : allV;
  }

  // 왼쪽 슬라이더(적정 폭/소신 폭)는 모든 학과에 동일하게 적용되는 "기본" 여유 폭입니다.
  // 여기에 그 학과 자신의 최근 3년 변동성(volatility, 표준편차)을 그대로 더해서
  // "이 학과는 원래 컷이 잘 안 흔들리니 기본 폭만으로 충분", "이 학과는 흔들림이 커서 그만큼 더 여유가 있어야 안정" 을
  // 슬라이더 값 자체를 학과마다 따로 조작하지 않고도 자동으로 반영합니다.
  function classify(cut, volatility){
    if(state.coreAvgOrAll==null) return null;
    const vAdj = volatility || 0;
    const effSafe = state.marginSafe + vAdj;
    const effReach = state.marginReach + vAdj;
    const diff = state.coreAvgOrAll - cut;
    if(diff > effReach) return '상향';
    if(diff > effSafe) return '소신';
    if(diff >= -effSafe) return '적정';
    return '안정';
  }

  const GROUP_META = {
    '상향': {color:'var(--reach)', desc:'현재 등급보다 커트라인이 훨씬 높아 도전이 필요한 대학'},
    '소신': {color:'var(--bold)', desc:'커트라인이 다소 높지만 해볼 만한 대학'},
    '적정': {color:'var(--match)', desc:'현재 등급과 커트라인이 맞아떨어지는 대학'},
    '안정': {color:'var(--safe)', desc:'현재 등급보다 커트라인이 낮아 안정적으로 합격을 기대할 수 있는 대학'},
  };

  // ---------- 렌더: 학과 매칭 ----------
  function renderMatch(){
    const rows = filteredRows();
    const grouped = groupRows(rows);
    const { map: tmap } = tierLookup(state.track, state.admtype);

    const studentVal = getStudentVal();
    state.coreAvgOrAll = studentVal;

    const tagEl = document.getElementById('lAdmStudentTag');
    if(tagEl){
      const usedLabel = state.admtype===0 ? coreLabelText() : '전과목 평균등급';
      tagEl.innerHTML = studentVal!=null
        ? `📌 지금은 <b>${state.admtype===0?'교과전형':'종합전형'}</b> 기준 · <b>${usedLabel} ${studentVal.toFixed(2)}</b>로 분류합니다`
        : `📌 지금은 <b>${state.admtype===0?'교과전형':'종합전형'}</b> 기준 · 왼쪽에서 <b>${usedLabel}</b>을 입력하면 이 값으로 분류합니다`;
    }

    grouped.forEach(g=>{
      const tinfo = tmap.get(g.univ);
      g.tier = tinfo ? tinfo.tier : null;
      g.rank = tinfo ? tinfo.rank : null;
      g.klass = studentVal!=null ? classify(g.cut, g.volatility) : null;
    });

    grouped.sort((a,b)=> (a.tier||99)-(b.tier||99) || a.cut-b.cut);

    const safeItemsEl = document.getElementById('lSafeItems');
    if(studentVal==null || !state.majorQuery.trim()){
      safeItemsEl.innerHTML = '<span class="empty">학생 등급과 희망 학과를 입력하면 이 학생에게 가장 안정적인 대학이 여기 먼저 뜹니다.</span>';
    } else {
      const safes = grouped.filter(g=>g.klass==='안정').sort((a,b)=> b.cut-a.cut).slice(0,6);
      if(safes.length===0){
        safeItemsEl.innerHTML = '<span class="empty">현재 조건에서 안정권으로 분류되는 학과가 없습니다. 지역/학과 범위를 넓혀보세요.</span>';
      } else {
        safeItemsEl.innerHTML = safes.map(g=>`<span class="pill-chip"><span class="u">${P.univs[g.univ]}</span><span class="c">${P.depts[g.dept]} · ${g.tier?g.tier+'군':''} · ${g.cut.toFixed(2)}등급</span></span>`).join('');
      }
    }

    const byClass = {'상향':[], '소신':[], '적정':[], '안정':[]};
    grouped.forEach(g=>{ if(g.klass) byClass[g.klass].push(g); else (byClass['미분류']=byClass['미분류']||[]).push(g); });

    const container = document.getElementById('lMatchGroups');
    if(grouped.length===0){
      container.innerHTML = '<div class="empty-state">'+(state.majorQuery.trim()? '조건에 맞는 학과 데이터가 없습니다. 지역이나 학과명을 조정해보세요.' : '왼쪽에서 희망 학과를 입력하면 결과가 여기 나타납니다.')+'</div>';
      return;
    }

    let html = '';
    renderedEntries = [];
    const order = studentVal!=null ? ['상향','소신','적정','안정'] : ['미분류'];
    order.forEach(kname=>{
      const list = byClass[kname] || [];
      if(list.length===0 && kname!=='미분류') return;
      const meta = GROUP_META[kname] || {color:'var(--ink-soft)', desc:'등급을 입력하면 상향/소신/적정/안정으로 자동 분류됩니다.'};
      html += `<div class="group">
        <div class="group-head"><span class="dot" style="background:${meta.color}"></span><h3>${kname}</h3><span class="count">${list.length}개 학과 · ${meta.desc} · 행을 클릭하면 3개년 추이를 볼 수 있어요</span></div>
        <div class="scroll-x"><table class="results">
          <thead><tr>
            <th></th>
            <th data-sort-key="univ">대학${sortArrow('univ')}</th>
            <th data-sort-key="dept">학과${sortArrow('dept')}</th>
            <th data-sort-key="region">지역${sortArrow('region')}</th>
            <th data-sort-key="tier">군${sortArrow('tier')}</th>
            <th>등급50/70(최근)</th>
            <th data-sort-key="cut">대표컷${sortArrow('cut')}</th>
            <th data-sort-key="volatility">최근 3년 변동${sortArrow('volatility')}</th>
            <th data-sort-key="year">연도${sortArrow('year')}</th>
          </tr></thead>
          <tbody>`;
      list.sort(sortComparator(state.sortKey, state.sortDir)).forEach(g=>{
        const y = g.years[g.repYear];
        const vt = volatilityTag(g.volatility, g.volN);
        const idx = renderedEntries.push(g) - 1;
        const badge = g.klass ? `<span class="klass-badge klass-${KLASS_CSS[g.klass]}">${g.klass}</span>` : '';
        html += `<tr data-idx="${idx}">
          <td>${badge}</td>
          <td><b>${P.univs[g.univ]}</b></td>
          <td>${P.depts[g.dept]}${g.subdept>=0? '<span class="region-tag"> · '+P.subdepts[g.subdept]+'</span>':''}</td>
          <td class="region-tag">${P.regions[g.region]}</td>
          <td>${g.tier? '<span class="tier-tag">'+g.tier+'군 · '+g.rank+'위</span>':'-'}</td>
          <td class="num">${y.g50!=null?y.g50.toFixed(2):'-'} / ${y.g70!=null?y.g70.toFixed(2):'-'}</td>
          <td class="num"><b>${g.cut.toFixed(2)}</b></td>
          <td class="num ${vt.cls}" title="최근 2024~2026학년도 중 자료가 있는 ${g.volN}개년 대표컷의 표준편차 · 이 값이 왼쪽 적정/소신 폭에 자동으로 더해져 이 학과의 상향/소신/적정/안정 판정에 반영됩니다">${vt.text}</td>
          <td class="num">${g.repYear}</td>
        </tr>`;
      });
      html += `</tbody></table></div></div>`;
    });
    container.innerHTML = html;
  }

  // ---------- 행 클릭 → 미니 상세 팝업 (최근 3개년 합격선·경쟁률 추이 + 관심대학 저장) ----------
  function buildFavSnapshot(g){
    const track = state.track===0 ? '인문' : (state.track===1 ? '자연' : '의치한약수');
    const admtype = state.admtype===0 ? '교과전형' : '종합전형';
    const years = {};
    [2024,2025,2026].forEach(y=>{
      const yy = g.years[y];
      years[y] = yy ? { g50:yy.g50, g70:yy.g70, cr:yy.cr } : null;
    });
    return {
      univ: P.univs[g.univ], dept: P.depts[g.dept],
      subdept: g.subdept>=0 ? P.subdepts[g.subdept] : null,
      region: P.regions[g.region], track, admtype,
      cut: g.cut, volatility: g.volatility, volN: g.volN, klass: g.klass || null,
      years,
    };
  }

  function openDetailModal(g){
    const snap = buildFavSnapshot(g);
    const vt = volatilityTag(snap.volatility, snap.volN);
    const cutSeries = [2024,2025,2026].map(y=>{
      const yy = snap.years[y];
      if(!yy) return { label:String(y).slice(2)+"'", value:null };
      const vals = [yy.g50, yy.g70].filter(v=>v!=null);
      return { label:String(y).slice(2)+"'", value: vals.length ? vals.reduce((a,b)=>a+b,0)/vals.length : null };
    });
    const crSeries = [2024,2025,2026].map(y=>{
      const yy = snap.years[y];
      return { label:String(y).slice(2)+"'", value: (yy && yy.cr!=null) ? yy.cr : null };
    });

    const content = document.getElementById('lDetailContent');
    content.innerHTML = `
      <h4>${snap.univ} · ${snap.dept}</h4>
      <div class="dm-sub">${snap.track}${snap.subdept? ' · '+snap.subdept:''} · ${snap.region} · ${snap.admtype}</div>
      <div class="dm-row"><span>대표컷(등급50·70 평균)</span><b class="num">${snap.cut.toFixed(2)}등급</b></div>
      <div class="dm-row"><span>최근 3년 변동</span><span class="num ${vt.cls}">${vt.text}</span></div>
      ${snap.klass ? `<div class="dm-row"><span>현재 판정</span><span class="klass-badge klass-${KLASS_CSS[snap.klass]}">${snap.klass}</span></div>` : ''}
      <div class="dm-section-title">최근 3개년 합격선 (대표컷, 9등급제)</div>
      ${sparkLine(cutSeries, 264, 66)}
      <div class="dm-section-title">최근 3개년 경쟁률</div>
      ${sparkBar(crSeries, 264, 66)}
      <button class="dm-save-btn" id="lDetailSaveBtn" type="button"></button>
    `;
    const saveBtn = document.getElementById('lDetailSaveBtn');
    const paint = (saved)=>{
      saveBtn.textContent = saved ? '✓ 관심대학에 저장됨 · 클릭 시 삭제' : '★ 관심대학 저장';
      saveBtn.classList.toggle('saved', saved);
    };
    paint(isFavorited(snap));
    saveBtn.onclick = ()=>{ paint(toggleFavorite(snap)); if(state.mainTab==='favorites') renderFavorites(); };

    document.getElementById('lDetailBackdrop').classList.add('open');
  }
  function closeDetailModal(){
    document.getElementById('lDetailBackdrop').classList.remove('open');
  }

  // ---------- 렌더: 관심 대학 목록 ----------
  function renderFavorites(){
    const list = loadFavorites();
    document.getElementById('lFavCount').textContent = list.length+'개 저장됨';
    const wrap = document.getElementById('lFavList');
    if(list.length===0){
      wrap.innerHTML = '<div class="empty-state">"학과 매칭 추천" 표에서 행을 클릭하면 뜨는 팝업의 "★ 관심대학 저장" 버튼을 누르면 여기에 담깁니다.<br>이 목록은 지금 이 브라우저(이 PC)에만 저장되므로, 다른 PC로 옮기거나 백업해두려면 위의 "내보내기"로 파일을 저장한 뒤 그 PC에서 "불러오기"로 여시면 됩니다.</div>';
