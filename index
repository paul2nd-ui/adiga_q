    sorted.forEach(g=>{
      const vt = volatilityTag(g.volatility, g.volN);
      const d = g.savedAt ? new Date(g.savedAt) : null;
      const dateStr = d ? (d.getMonth()+1)+'/'+d.getDate() : '-';
      const badge = g.klass ? `<span class="klass-badge klass-${KLASS_CSS[g.klass]}">${g.klass}</span>` : '';
      html += `<tr>
        <td>${badge}</td>
        <td><b>${g.univ}</b></td>
        <td>${g.dept}${g.subdept? '<span class="region-tag"> · '+g.subdept+'</span>':''}</td>
        <td class="region-tag">${g.region}</td>
        <td class="num"><b>${g.cut.toFixed(2)}</b></td>
        <td class="num ${vt.cls}">${vt.text}</td>
        <td class="num">${dateStr}</td>
        <td><button class="fav-remove-btn" data-favkey="${favKey(g)}" type="button">삭제</button></td>
      </tr>`;
