function renderRegionList(){
  const el = document.getElementById('region-list');
  el.innerHTML = '';
  const allBtn = document.createElement('div');
  allBtn.className = 'region-item region-all' + (state.region==='전체' ? ' active' : '');
  allBtn.textContent = '전체';
  allBtn.addEventListener('click', ()=>{ state.region='전체'; state.univSearch=''; document.getElementById('f-univ-search').value=''; renderRegionList(); renderUnivList(); });
  el.appendChild(allBtn);
  REGIONS.forEach(r=>{
    const cls = REGION_GROUP[r] || '';
    const item = document.createElement('div');
    item.className = 'region-item ' + cls + (state.region===r ? ' active' : '');
    item.textContent = r;
    item.addEventListener('click', ()=>{ state.region=r; state.univSearch=''; document.getElementById('f-univ-search').value=''; renderRegionList(); renderUnivList(); });
    el.appendChild(item);
  });
}

// pre-compute univ -> region and dept-combo count for labeling
const univRegion = {};
const univComboCount = {};
ALL.forEach(r=>{
  univRegion[r[C.UNIV]] = REGIONS[r[C.REG]];
  const key = r[C.UNIV];
  if(!univComboCount[key]) univComboCount[key] = new Set();
  univComboCount[key].add(r[C.ADM] + '|' + r[C.DEPT]);
});

function renderUnivList(){
  const el = document.getElementById('univ-list');
  const q = state.univSearch.trim().toLowerCase();
  let indices = UNIVS.map((u,i)=>i);
  if(q){
    indices = indices.filter(i => UNIVS[i].toLowerCase().includes(q));
  } else if(state.region !== '전체'){
    indices = indices.filter(i => univRegion[i] === state.region);
  }
  indices.sort((a,b)=> UNIVS[a].localeCompare(UNIVS[b], 'ko'));
  document.getElementById('univ-count-label').textContent = '(' + indices.length + '개교)';
  el.innerHTML = '';
  if(indices.length===0){
    el.innerHTML = '<div style="padding:12px;color:#9aa0a8;font-size:12.5px;">해당 대학이 없습니다</div>';
    return;
  }
  indices.forEach(i=>{
    const item = document.createElement('div');
    item.className = 'univ-item' + (state.univIdx===i ? ' active' : '');
    const cnt = univComboCount[i] ? univComboCount[i].size : 0;
    item.innerHTML = escapeHtml(UNIVS[i]) + '<span class="cnt">' + cnt + '</span>';
    item.addEventListener('click', ()=>{ try{ selectUniv(i); }catch(e){ console.error('[univ-item click]', e); showInitError('대학선택클릭', e); } });
    el.appendChild(item);
  });
}

function selectUniv(i){
  try{
    state.univIdx = i;
    state.deptSearch = '';
    document.getElementById('f-dept-search').value = '';
    state.types = new Set();
    state.tracks = new Set();
    state.adms = new Set();
    document.getElementById('hdr-univ').textContent = UNIVS[i];
    document.getElementById('empty-card').style.display = 'none';
    document.getElementById('data-card').style.display = 'block';
    closeDetail();
    renderUnivList();
    renderCombo('type');
    renderCombo('track');
    renderCombo('adm');
    renderPivot();
  }catch(e){
    console.error('[selectUniv]', e);
    showInitError('대학선택', e);
  }
}

function renderHeaderComboList(query){
  const listEl = document.getElementById('hdr-combo-list');
  const q = (query || '').trim().toLowerCase();
  listEl.innerHTML = '';
  if(q){
    const indices = UNIVS.map((u,i)=>i).filter(i=>UNIVS[i].toLowerCase().includes(q)).sort((a,b)=>UNIVS[a].localeCompare(UNIVS[b],'ko'));
    if(indices.length===0){ listEl.innerHTML = '<div class="hdr-combo-empty">검색 결과가 없습니다</div>'; return; }
    indices.forEach(i=>{
      const item = document.createElement('div');
      item.className = 'hdr-combo-item' + (state.univIdx===i ? ' active' : '');
      item.textContent = UNIVS[i];
      item.addEventListener('click', ()=> chooseFromHeaderCombo(i));
      listEl.appendChild(item);
    });
    return;
  }
  const byRegion = {};
  REGIONS.forEach(r => byRegion[r] = []);
  UNIVS.forEach((u,i) => { const r = univRegion[i] || '기타'; if(!byRegion[r]) byRegion[r]=[]; byRegion[r].push(i); });
  REGIONS.forEach(r=>{
    const list = byRegion[r];
    if(!list || list.length===0) return;
    list.sort((a,b)=> UNIVS[a].localeCompare(UNIVS[b], 'ko'));
    const label = document.createElement('div');
    label.className = 'hdr-combo-group-label';
    label.textContent = r;
    listEl.appendChild(label);
    list.forEach(i=>{
      const item = document.createElement('div');
      item.className = 'hdr-combo-item' + (state.univIdx===i ? ' active' : '');
      item.textContent = UNIVS[i];
      item.addEventListener('click', ()=> chooseFromHeaderCombo(i));
      listEl.appendChild(item);
    });
  });
}

function chooseFromHeaderCombo(i){
  state.univSearch = '';
  document.getElementById('f-univ-search').value = '';
  state.region = '전체';
  renderRegionList();
  selectUniv(i);
  document.getElementById('hdr-combo-panel').classList.remove('open');
  document.getElementById('hdr-combo-search').value = '';
  renderHeaderComboList(''); // refresh back to the full grouped list with the new active item highlighted
}

function populateHeaderSelect(){
  const btn = document.getElementById('hdr-combo-btn');
  const panel = document.getElementById('hdr-combo-panel');
  const search = document.getElementById('hdr-combo-search');

  renderHeaderComboList('');

  btn.addEventListener('click', (e)=>{
    e.stopPropagation();
    const isOpen = panel.classList.contains('open');
    document.querySelectorAll('.combo-panel.open, .hdr-combo-panel.open').forEach(p=>p.classList.remove('open'));
    if(!isOpen){
      renderHeaderComboList(search.value);
      panel.classList.add('open');
      search.focus();
    }
  });
  panel.addEventListener('click', e=> e.stopPropagation());
  search.addEventListener('input', e=> renderHeaderComboList(e.target.value));
  document.addEventListener('click', ()=> panel.classList.remove('open'));
}

